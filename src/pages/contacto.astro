---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contacto Eclipxia",
  "url": "https://www.eclipxia.com/contacto/",
  "mainEntity": {
    "@type": "Organization",
    "name": "Eclipxia",
    "email": "contacto@eclipxia.com",
    "url": "https://www.eclipxia.com",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "email": "contacto@eclipxia.com",
      "availableLanguage": "Spanish",
      "hoursAvailable": "Mo-Fr 09:00-18:00"
    }
  }
};
---

<BaseLayout
  title="Contacto | Eclipxia — Diagnóstico Gratuito de IA Empresarial"
  description="Agenda un diagnóstico gratuito con Eclipxia. En 90 minutos identificamos los casos de uso de IA con mayor retorno para tu empresa. Sin compromiso."
  activePage="contacto"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="min-h-[40dvh] flex items-end pt-16 bg-zinc-950 relative overflow-hidden grid-bg">
    <div class="absolute inset-0 bg-gradient-to-b from-zinc-950/60 to-zinc-950 pointer-events-none"></div>
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 w-full pb-16 pt-24 relative z-10">
      <span class="text-xs font-semibold tracking-[0.25em] text-cyan-400 uppercase block mb-6 hero-eyebrow">Contacto</span>
      <h1 class="text-4xl lg:text-5xl xl:text-6xl font-black tracking-tight leading-[1.05]">
        <span class="hero-word">Hablemos</span>
        <span class="hero-word"> de</span>
        <span class="hero-word"> lo</span>
        <span class="hero-word"> que</span>
        <br />
        <span class="hero-word">necesita</span>
        <span class="hero-word"> <span class="text-cyan-400">construir.</span></span>
      </h1>
    </div>
  </section>

  <!-- MAIN SPLIT LAYOUT -->
  <section class="bg-zinc-950 py-20">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-[45fr_55fr] gap-16 items-start">

        <!-- LEFT: Value prop + contact + timeline -->
        <div class="reveal-up">
          <div class="mb-10">
            <h2 class="text-2xl font-bold text-zinc-50 mb-4">Diagn&oacute;stico gratuito, sin compromiso</h2>
            <p class="text-zinc-400 leading-relaxed mb-6">90 minutos de conversaci&oacute;n t&eacute;cnica honesta. Analizamos su situaci&oacute;n, identificamos donde la IA puede ayudar — y donde no vale la pena — y le damos un plan de acci&oacute;n concreto.</p>
            <p class="text-zinc-500 text-sm leading-relaxed">No hay PowerPoint. No hay propuesta de venta disfrazada de consultor&iacute;a. Solo una conversaci&oacute;n entre ingenieros sobre su problema real.</p>
          </div>

          <!-- Contact info -->
          <div class="space-y-4 mb-12">
            <a href="mailto:contacto@eclipxia.com" class="flex items-center gap-4 group">
              <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center group-hover:border-cyan-400/40 transition-colors flex-shrink-0">
                <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
              </div>
              <div>
                <div class="text-xs text-zinc-600 mb-0.5">Email</div>
                <div class="text-sm text-zinc-300 group-hover:text-cyan-400 transition-colors">contacto@eclipxia.com</div>
              </div>
            </a>
            <a href="https://linkedin.com/company/eclipxia" target="_blank" rel="noopener" class="flex items-center gap-4 group">
              <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center group-hover:border-cyan-400/40 transition-colors flex-shrink-0">
                <svg class="w-5 h-5 text-cyan-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </div>
              <div>
                <div class="text-xs text-zinc-600 mb-0.5">LinkedIn</div>
                <div class="text-sm text-zinc-300 group-hover:text-cyan-400 transition-colors">linkedin.com/company/eclipxia</div>
              </div>
            </a>
            <div class="flex items-center gap-4">
              <div class="w-11 h-11 rounded-xl bg-zinc-900 border border-zinc-800 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              </div>
              <div>
                <div class="text-xs text-zinc-600 mb-0.5">Tiempo de respuesta</div>
                <div class="text-sm text-zinc-300">Menos de 24 horas</div>
              </div>
            </div>
          </div>

          <!-- What happens next timeline -->
          <div>
            <h3 class="text-sm font-semibold text-zinc-400 uppercase tracking-widest mb-6">Qu&eacute; pasa despu&eacute;s</h3>
            <div class="relative space-y-8">
              <div class="timeline-line"></div>
              <div class="relative flex gap-5 pl-12">
                <div class="absolute left-0 w-10 h-10 rounded-full bg-cyan-400/10 border border-cyan-400/40 flex items-center justify-center flex-shrink-0">
                  <span class="text-sm font-bold text-cyan-400">1</span>
                </div>
                <div class="pt-1">
                  <h4 class="text-sm font-semibold text-zinc-50 mb-1">Le respondemos en &lt;24h</h4>
                  <p class="text-zinc-500 text-sm">Revisamos su mensaje y coordinamos una llamada. Sin bot, sin formulario de calificaci&oacute;n.</p>
                </div>
              </div>
              <div class="relative flex gap-5 pl-12">
                <div class="absolute left-0 w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center flex-shrink-0">
                  <span class="text-sm font-bold text-zinc-400">2</span>
                </div>
                <div class="pt-1">
                  <h4 class="text-sm font-semibold text-zinc-50 mb-1">Sesi&oacute;n de diagn&oacute;stico (90 min)</h4>
                  <p class="text-zinc-500 text-sm">Mapeamos su situaci&oacute;n real: sistemas actuales, datos disponibles, procesos con mayor fricción.</p>
                </div>
              </div>
              <div class="relative flex gap-5 pl-12">
                <div class="absolute left-0 w-10 h-10 rounded-full bg-zinc-800 border border-zinc-700 flex items-center justify-center flex-shrink-0">
                  <span class="text-sm font-bold text-zinc-400">3</span>
                </div>
                <div class="pt-1">
                  <h4 class="text-sm font-semibold text-zinc-50 mb-1">Plan de acci&oacute;n concreto</h4>
                  <p class="text-zinc-500 text-sm">Entregamos un resumen con los 2-3 casos de uso con mayor impacto y una propuesta concreta si aplica.</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- RIGHT: Contact form -->
        <div class="reveal-up">
          <div class="bg-zinc-900 border border-zinc-800 rounded-2xl p-8 lg:p-10">
            <h2 class="text-xl font-bold text-zinc-50 mb-2">Cuente su caso</h2>
            <p class="text-zinc-500 text-sm mb-8">La informaci&oacute;n que comparta es confidencial y solo la usan los ingenieros que analizan su caso.</p>

            <div id="form-success" class="form-success">
              <div class="success-icon w-16 h-16 rounded-full bg-cyan-400/10 border border-cyan-400/30 flex items-center justify-center mb-6">
                <svg class="w-8 h-8 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              <h3 class="text-xl font-bold text-zinc-50 mb-2">Mensaje recibido</h3>
              <p class="text-zinc-400 text-sm text-center max-w-xs">Le respondemos en menos de 24 horas. Revise tambi&eacute;n su carpeta de spam por si acaso.</p>
            </div>

            <form id="contact-form" class="space-y-5">
              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label class="form-label" for="nombre">Nombre completo *</label>
                  <input type="text" id="nombre" name="nombre" class="form-input" placeholder="Rodrigo Almeida" required />
                  <span class="error-msg" id="nombre-error">Este campo es requerido</span>
                </div>
                <div>
                  <label class="form-label" for="empresa">Empresa *</label>
                  <input type="text" id="empresa" name="empresa" class="form-input" placeholder="Empresa S.A." required />
                  <span class="error-msg" id="empresa-error">Este campo es requerido</span>
                </div>
              </div>

              <div>
                <label class="form-label" for="cargo">Cargo</label>
                <select id="cargo" name="cargo" class="form-input">
                  <option value="">Seleccionar cargo</option>
                  <option value="CEO / Director General">CEO / Director General</option>
                  <option value="CTO / Director de Tecnolog&iacute;a">CTO / Director de Tecnolog&iacute;a</option>
                  <option value="COO / Director de Operaciones">COO / Director de Operaciones</option>
                  <option value="Director de RRHH">Director de RRHH</option>
                  <option value="Gerente de &Aacute;rea">Gerente de &Aacute;rea</option>
                  <option value="Jefe de Proyecto">Jefe de Proyecto</option>
                  <option value="Otro">Otro</option>
                </select>
              </div>

              <div>
                <label class="form-label" for="email">Correo corporativo *</label>
                <input type="email" id="email" name="email" class="form-input" placeholder="usted@empresa.com" required />
                <span class="error-msg" id="email-error">Ingrese un email v&aacute;lido</span>
              </div>

              <div>
                <label class="form-label" for="problema">&iquest;Qu&eacute; necesita resolver? *</label>
                <textarea
                  id="problema"
                  name="problema"
                  rows="4"
                  class="form-input resize-none"
                  placeholder="Describa el problema o proceso que quiere mejorar con IA. Cuanto m&aacute;s espec&iacute;fico, mejor podemos preparar la sesi&oacute;n."
                  required
                ></textarea>
                <span class="error-msg" id="problema-error">Por favor describa su caso</span>
              </div>

              <div>
                <label class="form-label" for="fuente">&iquest;C&oacute;mo supo de Eclipxia?</label>
                <select id="fuente" name="fuente" class="form-input">
                  <option value="">Seleccionar</option>
                  <option value="LinkedIn">LinkedIn</option>
                  <option value="B&uacute;squeda en Google">B&uacute;squeda en Google</option>
                  <option value="Recomendaci&oacute;n de un colega">Recomendaci&oacute;n de un colega</option>
                  <option value="Artículo o blog">Art&iacute;culo o blog</option>
                  <option value="Evento o conferencia">Evento o conferencia</option>
                  <option value="Otro">Otro</option>
                </select>
              </div>

              <button
                type="submit"
                class="cta-btn w-full bg-cyan-400 text-zinc-950 font-bold py-4 rounded-xl hover:bg-cyan-300 transition-colors"
              >
                Enviar y agendar diagn&oacute;stico
              </button>

              <p class="text-xs text-zinc-600 text-center">Al enviar acepta que Eclipxia guarde su informaci&oacute;n para responder a su consulta.</p>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.hero-eyebrow', { y: 20, opacity: 0, duration: 0.6, ease: 'power3.out', delay: 0.2 });
  gsap.from('.hero-word', { y: 60, opacity: 0, stagger: 0.05, duration: 0.8, ease: 'power4.out', delay: 0.35 });

  gsap.utils.toArray('.reveal-up').forEach((el: any) => {
    gsap.from(el, {
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' },
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out'
    });
  });

  // Form handling
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successDiv = document.getElementById('form-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    let valid = true;

    // Basic validation
    const fields = ['nombre', 'empresa', 'email', 'problema'];
    fields.forEach(field => {
      const input = document.getElementById(field) as HTMLInputElement | HTMLTextAreaElement;
      const error = document.getElementById(`${field}-error`);
      if (!input?.value.trim()) {
        input?.classList.add('error');
        error?.classList.add('show');
        valid = false;
      } else {
        input?.classList.remove('error');
        error?.classList.remove('show');
      }
    });

    if (valid) {
      // Show success state
      form.style.display = 'none';
      if (successDiv) {
        successDiv.classList.add('show');
      }
    }
  });

  // Remove error on input
  document.querySelectorAll('.form-input').forEach(input => {
    input.addEventListener('input', () => {
      (input as HTMLElement).classList.remove('error');
      const errorEl = document.getElementById(`${(input as HTMLElement).id}-error`);
      errorEl?.classList.remove('show');
    });
  });
</script>
