        <table class="tbl tbl-cmp" data-reveal style="--i:2">
          <thead>
            <tr><th>Concepto</th><th>Licencias por usuario</th><th class="col-us">Cerebro corporativo Eclipxia</th></tr>
          </thead>
          <tbody>
            {comparativa.map(([a, b, c], i) => (
              <tr style={`--r:${i}`}>
                <td data-label="Concepto">{a}</td>
                <td data-label="Licencias por usuario">{b}</td>
                <td class="col-us" data-label="Cerebro corporativo Eclipxia">{c}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- COMERCIAL -->
    <section class="sec alt" id="comercial">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Inversión</p>
        <h2 data-reveal style="--i:1">Tres etapas, sin costo por usuario.</h2>
        <div class="price-grid">
          {comercial.map(([tag, price, items, hi], i) => (
            <article class:list={['card', 'price', hi && 'card-hi']} data-reveal style={`--i:${i + 2}`}>
              <p class="tag">{tag}</p>
              <p class="price-big grad">{price}</p>
              <ul>
                {(items as string[]).map((it) => <li>{it}</li>)}
              </ul>
            </article>
          ))}
        </div>
        <p class="note" data-reveal style="--i:5">Consumo de modelos: pago por uso real, facturado por el proveedor a nombre de tu empresa, con topes por usuario, área y empresa.</p>
      </div>
