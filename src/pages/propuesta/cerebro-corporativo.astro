];

const solucion = [
  ['Privado', 'Instalado en tu nube o servidor dedicado. Un entorno exclusivo por cliente, nunca compartido.'],
  ['Con tu conocimiento', 'Responde con tus manuales, contratos y datos, y cita la fuente de cada respuesta.'],
  ['Por departamento', 'Cerebros separados para Legal, RR.HH., Operaciones o Finanzas, cada uno con su acceso.'],
  ['Pago por uso', 'Usuarios ilimitados. Pagas el consumo real, con límites por usuario, área y empresa.'],
];

const funciones = [
  ['Conocimiento por área', 'Colecciones de documentos por departamento; carga de PDF, Word, Excel, PowerPoint y escaneados.'],
  ['Respuestas con fuente', 'Cada respuesta muestra de qué documento salió, con un clic al fragmento.'],
  ['Búsqueda híbrida', 'Por significado y por palabra exacta, con reordenamiento por relevancia.'],
  ['Usuarios y permisos', 'Roles, grupos por área, permisos por asistente y por base de conocimiento, aprobación de usuarios nuevos.'],
  ['Login corporativo', 'Google Workspace, Microsoft Entra ID, LDAP, alta y baja automática de usuarios.'],
  ['Asistentes por departamento', 'Cada área tiene su asistente con instrucciones, conocimiento y herramientas propias.'],
  ['Varios modelos', 'Elige el modelo por tarea y compara respuestas lado a lado.'],
  ['Experiencia tipo ChatGPT', 'En español, historial y carpetas, chats compartidos, dictado por voz, app instalable en el celular, biblioteca de instrucciones.'],
