---
import BaseLayout, { WHATSAPP_URL, PHONE_DISPLAY } from '../../layouts/BaseLayout.astro';
import '../../styles/propuesta.css';

const problema = [
  ['01', 'IA en la sombra', 'Empleados suben contratos, cifras y estrategias a cuentas personales de IA. La empresa no ve ni controla qué sale.'],
  ['02', 'Conocimiento disperso', 'Manuales, políticas y contratos repartidos entre carpetas, correos y la cabeza de pocas personas.'],
