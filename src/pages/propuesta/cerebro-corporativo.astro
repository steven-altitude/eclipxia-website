const shots = {
  'Usuarios y permisos': { src: '/propuesta/cerebro-corporativo/grupos.png', w: 2400, h: 525, alt: 'Panel de grupos por área del cerebro corporativo: Comercial, Finanzas, Gerencia, Legal, Operaciones y RR.HH.' },
  'Experiencia tipo ChatGPT': { src: '/propuesta/cerebro-corporativo/movil.png', w: 780, h: 1688, alt: 'El cerebro corporativo de Eclipxia en el celular, con una respuesta citada', phone: true },
  'Asistentes por departamento': { src: '/propuesta/cerebro-corporativo/cerebros.png', w: 2400, h: 428, alt: 'Lista de asistentes del cerebro corporativo: Cerebro Legal, Cerebro RR.HH. y Cerebro Operaciones' },
};

const ragSteps = [
  ['01', 'Ingesta', 'Extrae texto y tablas de PDF, Word, Excel, sitios y bases de datos. Limpia y normaliza.'],
  ['02', 'Fragmentos', 'Divide en fragmentos padre e hijo: los pequeños para buscar, los grandes para dar contexto.'],
  ['03', 'Índice', 'Vectores generados dentro de tu servidor e índice de texto completo, con metadatos de área y vigencia.'],
  ['04', 'Búsqueda', 'Búsqueda híbrida (semántica y por palabra exacta), filtro por permisos y reordenamiento por relevancia.'],
  ['05', 'Respuesta', 'El modelo responde solo con lo recuperado y cita el documento y la sección de origen.'],
];

const fuentes = [
  ['Documentos', 'PDF, Word, Excel, PowerPoint, texto. Incluye documentos escaneados con reconocimiento de texto.'],
  ['Repositorios', 'SharePoint, OneDrive, Google Drive, Notion y carpetas de red.'],
  ['Sistemas', 'Bases de datos SQL, ERP y CRM por API, en consultas de solo lectura.'],
  ['Web', 'Sitio corporativo, intranet y portales internos, rastreados de forma programada.'],
];

const calidad = [
  ['Respuesta con fuente', 'Cada respuesta indica el documento y la sección de donde sale.'],
  ['"No lo sé" explícito', 'Umbral de relevancia: si no hay información suficiente, lo dice en vez de inventar.'],
  ['Búsqueda híbrida + reordenamiento', 'Encuentra tanto conceptos como códigos, números de contrato y nombres exactos.'],
  ['Filtros por metadatos', 'Prioriza la versión vigente de cada política y descarta documentos obsoletos.'],
  ['Set de pruebas propio', 'Antes de salir a producción, se evalúa con preguntas reales de tu equipo y sus respuestas correctas.'],
  ['Mejora continua', 'Las respuestas corregidas por usuarios alimentan ajustes en el mantenimiento mensual.'],
];

const usos = [
  ['LEGAL', 'Contratos y normativa', '“¿Qué penalidad tiene el contrato con este proveedor si entregamos tarde?”'],
  ['RECURSOS HUMANOS', 'Políticas internas', '“¿Cuántos días de vacaciones me corresponden y cómo los solicito?”'],
  ['OPERACIONES', 'Procedimientos', '“¿Cuál es el procedimiento de despacho para un cliente de exportación?”'],
  ['COMERCIAL', 'Productos y precios', '“¿Qué condiciones de pago aplican a un distribuidor nuevo?”'],
  ['FINANZAS', 'Procesos y reportes', '“¿Qué documentos necesito para registrar el pago a un proveedor del exterior?”'],
  ['GERENCIA', 'Visión completa', 'Acceso a todos los cerebros, para cruzar información entre áreas.'],
];

const acceso = [
  ['01', 'Login corporativo', 'Inicio de sesión con Google Workspace o Microsoft 365. Sin contraseñas nuevas.'],
  ['02', 'Grupos por área', 'Cada usuario pertenece a uno o varios grupos: Finanzas, Comercial, Gerencia.'],
  ['03', 'Cerebros visibles', 'Cada grupo ve solo sus cerebros. Un analista no puede consultar los documentos de Gerencia.'],
  ['04', 'Salida inmediata', 'Si alguien deja la empresa y se desactiva su cuenta corporativa, pierde el acceso al instante.'],
];
const accLabels = [
  ['Legal', '#FFB547'],
  ['RR.HH.', '#FF6A3D'],
  ['Operaciones', '#4DA3FF'],
  ['Finanzas', '#3DDC97'],
  ['Gerencia', '#F2F2F4'],
];

const deptMeters = [
  ['Legal', 38],
  ['RR.HH.', 22],
  ['Operaciones', 71],
  ['Finanzas', 55],
];

const capas = [
  ['Interfaz y accesos', 'Chat y login corporativo'],
  ['Motor de conocimiento', 'Cerebros por área y búsqueda'],
  ['Pasarela de modelos', 'Límites y consumo'],
  ['Base vectorial', 'Vectores generados aquí'],
  ['Sincronización', 'Actualiza el índice solo'],
  ['Respaldos', 'Cifrados, a tu nombre'],
];
const capaColors = ['#FFB547', '#4DA3FF', '#FF6A3D', '#7DBBFF', '#3DDC97', '#C8C8CE'];

const seguridad = [
  ['Ubicación', 'Documentos, índice, registros y respaldos en tu nube o servidor, a nombre de tu empresa.'],
  ['Lo que viaja al modelo', 'Solo la pregunta y los fragmentos necesarios. Tus documentos completos nunca salen.'],
  ['Entrenamiento', 'APIs empresariales directas con retención cero: el proveedor no guarda ni entrena con tus datos.'],
  ['Acceso', 'Login corporativo, grupos por área y desactivación inmediata al dar de baja una cuenta.'],
  ['Red', 'Solo HTTPS expuesto. Administración por VPN, sin puertos abiertos a internet.'],
  ['Trazabilidad', 'Registro de quién preguntó qué, qué fuentes se usaron y cuánto consumió.'],
];

const metodo = [
  ['01 · 5 DÍAS HÁBILES', 'Diagnóstico y prototipo', 'Revisión de seguridad de datos y un prototipo funcionando con tres de tus documentos críticos.'],
  ['02 · SEGÚN ALCANCE', 'Implementación', 'Despliegue en tu nube, login corporativo y tres cerebros departamentales.'],
  ['03 · TALLER', 'Adopción', 'Capacitación a tu equipo para usarlo bien desde el primer día.'],
  ['04 · MENSUAL', 'Gestión y evolución', 'Monitoreo, actualización del conocimiento y optimización del consumo.'],
];

const comparativa = [
  ['Costo mensual', '~USD 3.000 fijos (USD 30 × 100)', 'Gestión USD 600–1.200 + consumo real con tope'],
  ['Costo de entrada', 'Sin costo inicial', 'Implementación única USD 3.500–6.500'],
  ['Usuarios', 'Pagas cada asiento, lo use o no', 'Ilimitados'],
  ['Conocimiento', 'General, configuración por tu cuenta', 'Cerebros por área con fuentes citadas'],
  ['Dónde viven los datos', 'Nube del proveedor', 'Tu infraestructura'],
  ['Propiedad', 'Alquiler', 'La plataforma y el conocimiento son tuyos'],
];

const comercial = [
  ['01 · DIAGNÓSTICO', 'USD 600–1.000', ['Revisión de seguridad de datos', 'Limpieza de 3 documentos críticos', 'Prototipo funcional en 5 días', 'Descontable de la implementación'], false],
  ['02 · IMPLEMENTACIÓN ÚNICA', 'USD 3.500–6.500', ['Despliegue en tu nube privada', 'Login corporativo Google o Microsoft', '3 cerebros departamentales', 'Taller de adopción'], true],
  ['03 · GESTIÓN MENSUAL', 'USD 600–1.200', ['Monitoreo del servidor', 'Actualización del conocimiento', 'Optimización del consumo', 'Un agente o flujo nuevo al mes'], false],
];
---

<BaseLayout
  title="Propuesta confidencial | Cerebro corporativo privado | Eclipxia"
  description="Propuesta confidencial de Eclipxia."
  canonical="https://www.eclipxia.com/propuesta/cerebro-corporativo/"
  noindex
>
  <div class="pp-progress" data-progress aria-hidden="true"></div>

  <header class="pp-top">
    <a class="pp-logo" href="/propuesta/cerebro-corporativo/" aria-label="Eclipxia">
      <img src="/eclipxia-logo.png" alt="Eclipxia" style="height:22px;width:auto" />
    </a>
    <span class="pp-tag">Propuesta confidencial</span>
    <a class="pp-wa" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">WhatsApp</a>
  </header>

  <main class="pp">
    <!-- COVER -->
    <section class="pp-hero" id="cover">
      <div class="scene-box pp-hero-scene"><canvas data-scene="hero" aria-hidden="true"></canvas></div>
      <div class="pp-hero-copy">
        <p class="eyebrow hero-rise" style="--d:.1s">Eclipxia · Consultoría e ingeniería de IA · Ecuador</p>
        <h1 class="hero-rise" style="--d:.25s">Tu cerebro corporativo <span class="grad">privado.</span></h1>
        <p class="lead hero-rise" style="--d:.45s">Una IA que conoce los documentos, procedimientos y datos de tu empresa, con agentes que ejecutan el trabajo repetitivo. Instalada en tu propia infraestructura, con usuarios ilimitados y pago por consumo real.</p>
        <p class="eyebrow hero-rise hero-conf" style="--d:.65s">Propuesta confidencial</p>
      </div>
      <span class="hero-cue" aria-hidden="true"></span>
    </section>

    <!-- PROBLEMA -->
    <section class="sec alt" id="problema">
      <div class="wrap">
        <p class="eyebrow" data-reveal>El problema</p>
        <h2 data-reveal style="--i:1">Tu equipo ya usa IA. La pregunta es con qué información y en qué cuentas.</h2>
        <ol class="prob">
          {problema.map(([n, t, d], i) => (
            <li data-reveal style={`--i:${i + 2}`}>
              <span class="big-num grad">{n}</span>
              <div>
                <h3>{t}</h3>
                <p>{d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- SOLUCION -->
    <section class="sec" id="solucion">
      <div class="wrap">
        <p class="eyebrow" data-reveal>La solución</p>
        <h2 data-reveal style="--i:1">Un ChatGPT corporativo que conoce tu empresa y es tuyo.</h2>
        <div class="sol-grid">
          {solucion.map(([t, d], i) => (
            <article class:list={['card', i === 0 && 'card-hi']} data-reveal style={`--i:${i + 2}`}>
              {i === 0 && (
                <svg class="priv-art" viewBox="0 0 400 230" role="img" aria-label="Servidor exclusivo dentro del perímetro de tu empresa, protegido con candado">
                  <defs>
                    <radialGradient id="pvGlow" cx="50%" cy="50%" r="50%">
                      <stop offset="0" stop-color="#3DDC97" stop-opacity=".22" />
                      <stop offset="1" stop-color="#3DDC97" stop-opacity="0" />
                    </radialGradient>
                    <linearGradient id="pvSlab" x1="0" x2="1">
                      <stop offset="0" stop-color="#23252d" />
                      <stop offset="1" stop-color="#1a1b21" />
                    </linearGradient>
                  </defs>
                  <ellipse cx="200" cy="118" rx="170" ry="100" fill="url(#pvGlow)" />
                  <rect class="pv-perim" x="40" y="14" width="320" height="200" rx="22" fill="none" stroke="#3DDC97" stroke-opacity=".55" stroke-width="1.5" stroke-dasharray="6 7" />
                  <text x="60" y="38" fill="#3DDC97" font-family="Geist Mono, monospace" font-size="10" letter-spacing="2">TU INFRAESTRUCTURA</text>
                  <g transform="translate(130 58)">
                    <rect width="140" height="34" rx="7" fill="url(#pvSlab)" stroke="#45464F" />
                    <rect y="44" width="140" height="34" rx="7" fill="url(#pvSlab)" stroke="#45464F" />
                    <rect y="88" width="140" height="34" rx="7" fill="url(#pvSlab)" stroke="#45464F" />
                    <g fill="#5A5A62"><rect x="14" y="15" width="56" height="4" rx="2" /><rect x="14" y="59" width="56" height="4" rx="2" /><rect x="14" y="103" width="56" height="4" rx="2" /></g>
                    <circle class="pv-led" cx="118" cy="17" r="4" fill="#3DDC97" />
                    <circle class="pv-led d2" cx="118" cy="61" r="4" fill="#FFB547" />
                    <circle class="pv-led d3" cx="118" cy="105" r="4" fill="#3DDC97" />
                  </g>
                  <g transform="translate(286 124)">
                    <circle r="24" fill="#121317" stroke="#3DDC97" stroke-width="1.5" />
                    <path d="M-8 -3 v-6 a8 8 0 0 1 16 0 v6" fill="none" stroke="#3DDC97" stroke-width="2.2" stroke-linecap="round" />
                    <rect x="-11" y="-3" width="22" height="15" rx="3" fill="#3DDC97" />
                  </g>
                  <g class="pv-block" stroke="#FF5D5D" stroke-width="1.6" stroke-linecap="round">
                    <path d="M4 118 H30" stroke-dasharray="3 4" />
                    <path d="M32 112 l-8 12 M24 112 l8 12" />
                  </g>
                </svg>
              )}
              <h3>{t}</h3>
              <p>{d}</p>
            </article>
          ))}
        </div>
        <p class="note" data-reveal style="--i:6">Y sobre la misma base, agentes de IA que ejecutan tareas completas: cada mes, uno nuevo.</p>
      </div>
    </section>

    <!-- LA PLATAFORMA -->
    <section class="sec alt" id="plataforma">
      <div class="wrap">
        <p class="eyebrow" data-reveal>La plataforma</p>
        <h2 data-reveal style="--i:1">Así se ve el cerebro corporativo de tu empresa.</h2>

        <div class="plat-top">
          <figure class="browser" data-reveal style="--i:2">
            <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <img
              src="/propuesta/cerebro-corporativo/chat.png"
              width="1600"
              height="1000"
              alt="Interfaz del cerebro corporativo de Eclipxia con una respuesta citada"
              loading="lazy"
            />
          </figure>
          <aside class="rag-def" data-reveal style="--i:3">
            <p class="eyebrow eyebrow-blue">¿Qué es RAG?</p>
            <p class="rag-def-main">RAG (generación aumentada por recuperación) significa que, antes de responder, la IA busca en tus documentos y responde solo con lo que encontró, citando la fuente.</p>
            <p class="rag-def-sub">Como un abogado que revisa el expediente antes de opinar. Tus datos no entrenan al modelo: los consulta en el momento.</p>
          </aside>
        </div>

        <ul class="feat">
          {funciones.map(([t, d], i) => (
            <li data-reveal style={`--i:${(i % 2) + 1}`}>
              <span class="feat-n">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{t}</h3>
                <p>{d}</p>
                {shots[t] && (
                  <figure class:list={['browser browser-sm', shots[t].phone && 'phone']}>
                    {!shots[t].phone && <div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i></div>}
                    <img src={shots[t].src} width={shots[t].w} height={shots[t].h} alt={shots[t].alt} loading="lazy" />
                  </figure>
                )}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- RAG (sticky + three.js) -->
    <section class="rag" id="rag">
      <div class="rag-track" data-rag-track>
        <div class="rag-sticky">
          <div class="wrap rag-wrap">
            <div class="rag-head">
              <p class="eyebrow eyebrow-blue">Cómo funciona</p>
              <h2>De tus documentos a una respuesta verificable, en cinco etapas.</h2>
            </div>
            <div class="rag-body">
              <div class="scene-box rag-scene"><canvas data-scene="rag" aria-hidden="true"></canvas></div>
              <ol class="rag-steps">
                {ragSteps.map(([n, t, d]) => (
                  <li class="rag-step" data-rag-step>
                    <span class="rag-n">{n}</span>
                    <div>
                      <h3>{t}</h3>
                      <p>{d}</p>
                    </div>
                  </li>
                ))}
              </ol>
            </div>
            <p class="note rag-note">Técnica conocida como RAG (generación aumentada por recuperación). El modelo no se reentrena con tus datos: los consulta en el momento. Tus documentos completos nunca salen de tu servidor.</p>
            <div class="rag-bar" data-rag-bar aria-hidden="true"><i></i></div>
          </div>
        </div>
      </div>
    </section>

    <!-- FUENTES -->
    <section class="sec alt" id="fuentes">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Fuentes de conocimiento</p>
        <h2 data-reveal style="--i:1">Se conecta a donde ya vive tu información.</h2>
        <div class="src-grid">
          {fuentes.map(([t, d], i) => (
            <article class="card" data-reveal style={`--i:${i + 2}`}>
              <h3>{t}</h3>
              <p>{d}</p>
            </article>
          ))}
        </div>
        <div class="two">
          <p class="lead" data-reveal style="--i:2">Sincronización programada: cuando cambia un documento en el origen, el índice se actualiza sin intervención manual.</p>
          <p class="lead" data-reveal style="--i:3">Cada base de conocimiento se separa por área o nivel de confidencialidad, para controlar quién consulta qué.</p>
        </div>
        <figure class="shot" data-reveal style="--i:2">
          <div class="browser browser-sm"><div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <img src="/propuesta/cerebro-corporativo/conocimiento.png" width="1400" height="1120" alt="Base de conocimiento del área Legal con sus documentos indexados" loading="lazy" />
          </div>
          <figcaption>Base de conocimiento del área Legal: los documentos quedan indexados y listos para consultar.</figcaption>
        </figure>
      </div>
    </section>

    <!-- CALIDAD -->
    <section class="sec" id="calidad">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Calidad de respuesta</p>
        <h2 data-reveal style="--i:1">Una IA corporativa no puede inventar. Así lo controlamos.</h2>
        <table class="tbl" data-reveal style="--i:2">
          <thead><tr><th>Control</th><th>Qué hace</th></tr></thead>
          <tbody>
            {calidad.map(([a, b], i) => (
              <tr style={`--r:${i}`}>
                <td data-label="Control">{a}</td>
                <td data-label="Qué hace">{b}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <figure class="shot" data-reveal style="--i:2">
          <div class="browser browser-sm"><div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <img src="/propuesta/cerebro-corporativo/fuente-detalle.png" width="1600" height="784" alt="Detalle de una fuente citada: el fragmento exacto del contrato y su porcentaje de relevancia" loading="lazy" />
          </div>
          <figcaption>Un clic en la fuente muestra el fragmento exacto del documento y qué tan relevante fue para la respuesta.</figcaption>
        </figure>
      </div>
    </section>

    <!-- USOS -->
    <section class="sec alt" id="usos">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Cerebros departamentales</p>
        <h2 data-reveal style="--i:1">Un cerebro por área, con su propio conocimiento.</h2>
        <div class="usos-grid">
          {usos.map(([tag, t, d], i) => (
            <article class:list={['card', i === 5 && 'card-hi']} data-reveal style={`--i:${(i % 3) + 2}`}>
              <p class="tag">{tag}</p>
              <h3>{t}</h3>
              <p>{d}</p>
            </article>
          ))}
        </div>
        <figure class="shot" data-reveal style="--i:2">
          <div class="browser browser-sm"><div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <img src="/propuesta/cerebro-corporativo/modelo-edit.png" width="1600" height="830" alt="Configuración del Cerebro Legal: instrucciones, conocimiento asignado y herramientas" loading="lazy" />
          </div>
          <figcaption>Cada cerebro tiene sus propias instrucciones, su base de conocimiento y sus herramientas.</figcaption>
        </figure>
      </div>
    </section>

    <!-- ACCESO (three.js grafo) -->
    <section class="sec" id="acceso">
      <div class="wrap acc-wrap">
        <div class="acc-copy">
          <p class="eyebrow eyebrow-green" data-reveal>Control de acceso</p>
          <h2 data-reveal style="--i:1">Cada persona ve solo lo que su cargo le permite.</h2>
          <ol class="acc-steps">
            {acceso.map(([n, t, d], i) => (
              <li data-reveal style={`--i:${i + 2}`}>
                <span class="acc-n">{n}</span>
                <div>
                  <h3>{t}</h3>
                  <p>{d}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="note note-green" data-reveal style="--i:6">Los permisos se aplican en el servidor, no en la pantalla: un usuario no puede llegar a un documento de otra área por ningún camino.</p>
        </div>
        <div class="scene-box acc-scene" data-reveal style="--i:2">
          <canvas data-scene="acceso" role="img" aria-label="Grafo de usuarios conectados solo a su departamento; un acceso a un área ajena se corta"></canvas>
          <div class="acc-labels" aria-hidden="true">
            {accLabels.map(([n, c]) => (
              <span class="acc-label" data-acc-label style={`--c:${c}`}>{n}</span>
            ))}
          </div>
          <div class="acc-legend" aria-hidden="true">
            <span><i class="lg-ok"></i>Acceso permitido</span>
            <span class="acc-denied" data-acc-denied><i class="lg-no"></i>Acceso bloqueado</span>
          </div>
        </div>
      </div>
    <div class="wrap">
        <figure class="shot" data-reveal style="--i:2">
          <div class="browser browser-sm"><div class="browser-bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <img src="/propuesta/cerebro-corporativo/login.png" width="1480" height="980" alt="Pantalla de inicio de sesión de Eclipxia con Google y Microsoft" loading="lazy" />
          </div>
          <figcaption>Inicio de sesión con la cuenta corporativa: Google Workspace o Microsoft 365, sin contraseñas nuevas.</figcaption>
        </figure>
      </div>
    </section>

    <!-- CONSUMO -->
