    <!-- CIERRE -->
    <section class="sec cierre" id="cierre">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Siguiente paso</p>
        <h2 class="cierre-h" data-reveal style="--i:1">Pruébalo con tus propios documentos.</h2>
        <p class="lead" data-reveal style="--i:2">En 5 días hábiles revisamos la seguridad de tus datos y te entregamos un prototipo funcionando con tres de tus documentos críticos. El valor se descuenta de la implementación.</p>
        <div class="cierre-cta" data-reveal style="--i:3">
          <a class="pp-btn" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a>
          <a class="pp-btn pp-btn-ghost" href="mailto:hola@eclipxia.com">hola@eclipxia.com</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="pp-foot">
