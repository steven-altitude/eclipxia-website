---
import { getCollection, render } from 'astro:content';
import BaseLayout, { WHATSAPP_URL } from '../../layouts/BaseLayout.astro';
import BlogShell from '../../components/BlogShell.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;

const url = `https://www.eclipxia.com/blog/${post.id}/`;
const image = d.image ? new URL(d.image, 'https://www.eclipxia.com').href : undefined;
const fmt = (date: Date) =>
  date.toLocaleDateString('es-EC', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.seoDescription ?? d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  inLanguage: 'es-EC',
  mainEntityOfPage: url,
  url,
  ...(image ? { image } : {}),
  author: { '@type': 'Organization', name: d.author, url: 'https://www.eclipxia.com/' },
  publisher: { '@id': 'https://www.eclipxia.com/#organization' },
  articleSection: d.category,
  keywords: d.tags.join(', '),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.eclipxia.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.eclipxia.com/blog/' },
    { '@type': 'ListItem', position: 3, name: d.title, item: url },
  ],
};
---

<BaseLayout
  title={`${d.seoTitle ?? d.title} | Eclipxia`}
  description={d.seoDescription ?? d.description}
  canonical={url}
  ogImage={image}
  ogType="article"
  jsonLd={[articleLd, breadcrumbLd]}
>
  <BlogShell>
    <article class="post">
      <header class="post-head">
        <nav class="post-crumbs" aria-label="Ruta">
          <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/blog/">Blog</a>
        </nav>
        <p class="eyebrow">{d.category}</p>
        <h1 class="post-h1">{d.title}</h1>
        <p class="post-lede">{d.description}</p>
        <p class="post-meta">
          <time datetime={d.date.toISOString()}>{fmt(d.date)}</time>
          {d.updated && <span>Actualizado {fmt(d.updated)}</span>}
          <span>{d.author}</span>
        </p>
      </header>

      {image && (
        <img class="post-cover" src={d.image} alt={d.imageAlt ?? d.title} width="1200" height="630" />
      )}

      <div class="prose">
        <Content />
      </div>

      <aside class="post-cta">
        <p class="post-cta-q">¿Quieres ver qué podría hacer la IA en tu empresa?</p>
        <p class="post-cta-p">Cuéntanos tu proceso y te decimos, en una conversación, si la IA lo resuelve y por dónde empezar.</p>
        <a href={WHATSAPP_URL} class="btn-pill btn-pill-lg" target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a>
      </aside>
    </article>
  </BlogShell>
</BaseLayout>
