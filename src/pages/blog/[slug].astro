---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 3);

function formatDate(date: Date) {
  return date.toLocaleDateString('es-LA', { year: 'numeric', month: 'long', day: 'numeric' });
}

function readingTime(body: string) {
  const words = body.split(/\s+/).length;
  return Math.max(1, Math.round(words / 200));
}

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "datePublished": post.data.pubDate.toISOString(),
  "author": {
    "@type": "Organization",
    "name": post.data.author,
  },
  "publisher": {
    "@type": "Organization",
    "name": "Eclipxia",
    "url": "https://www.eclipxia.com"
  },
  "image": post.data.image,
  "inLanguage": "es",
};
---

<BaseLayout
  title={`${post.data.title} | Blog Eclipxia`}
  description={post.data.description}
  ogImage={post.data.image}
  activePage="blog"
  jsonLd={jsonLd}
>
  <!-- Post hero -->
  <section class="pt-24 pb-12 bg-zinc-950">
    <div class="max-w-[860px] mx-auto px-6 lg:px-10">
      <!-- Back link -->
      <a
        href="/blog/"
        class="inline-flex items-center gap-2 text-sm text-zinc-500 hover:text-zinc-300 transition-colors mb-10 group"
      >
        <svg class="w-4 h-4 rotate-180 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        Volver al blog
      </a>

      <!-- Category + reading time -->
      <div class="flex items-center gap-4 mb-6 reveal-up">
        <span class="text-xs font-semibold bg-cyan-400/10 text-cyan-400 border border-cyan-400/20 px-3 py-1.5 rounded-full">
          {post.data.category}
        </span>
        <span class="text-xs text-zinc-500">{readingTime(post.body ?? '')} min de lectura</span>
      </div>

      <!-- Title -->
      <h1 class="text-3xl lg:text-4xl xl:text-5xl font-black tracking-tight leading-[1.1] text-zinc-50 mb-6 reveal-up">
        {post.data.title}
      </h1>

      <!-- Meta -->
      <div class="flex items-center gap-4 mb-10 reveal-up">
        <div class="w-9 h-9 rounded-full bg-zinc-800 flex items-center justify-center text-sm font-bold text-zinc-300">
          {post.data.author.charAt(0)}
        </div>
        <div>
          <div class="text-sm font-medium text-zinc-300">{post.data.author}</div>
          <div class="text-xs text-zinc-600">{formatDate(post.data.pubDate)}</div>
        </div>
      </div>

      <!-- Featured image -->
      {post.data.image && (
        <div class="rounded-2xl overflow-hidden mb-12 reveal-up">
          <img
            src={post.data.image}
            alt={post.data.title}
            class="w-full h-64 lg:h-80 object-cover grayscale opacity-80"
          />
        </div>
      )}
    </div>
  </section>

  <!-- Post content -->
  <section class="bg-zinc-950 pb-24">
    <div class="max-w-[860px] mx-auto px-6 lg:px-10">
      <div class="prose prose-lg max-w-none reveal-up">
        <Content />
      </div>
    </div>
  </section>

  <!-- CTA after article -->
  <section class="bg-zinc-900 border-y border-zinc-800 py-16">
    <div class="max-w-[860px] mx-auto px-6 lg:px-10">
      <div class="grid lg:grid-cols-[1fr_auto] gap-8 items-center reveal-up">
        <div>
          <h3 class="text-xl font-bold text-zinc-50 mb-2">Su empresa tiene este problema.</h3>
          <p class="text-zinc-400 text-sm leading-relaxed">Hablemos de su caso espec&iacute;fico. 90 minutos, sin PowerPoint, sin compromiso.</p>
        </div>
        <a
          href="/contacto/"
          class="cta-btn bg-cyan-400 text-zinc-950 font-semibold px-6 py-3 rounded-xl hover:bg-cyan-300 transition-colors whitespace-nowrap text-sm"
        >
          Agendar diagn&oacute;stico
        </a>
      </div>
    </div>
  </section>

  <!-- Related posts -->
  {relatedPosts.length > 0 && (
    <section class="bg-zinc-950 py-20">
      <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
        <h2 class="text-2xl font-bold text-zinc-50 mb-8 reveal-up">M&aacute;s sobre {post.data.category}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
          {relatedPosts.map(related => (
            <a href={`/blog/${related.slug}/`} class="article-card bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden group block">
              {related.data.image && (
                <div class="article-image h-40">
                  <img
                    src={related.data.image}
                    alt={related.data.title}
                    class="w-full h-full object-cover grayscale opacity-70 group-hover:opacity-90 transition-opacity"
                  />
                </div>
              )}
              <div class="p-6">
                <span class="text-xs bg-zinc-800 text-zinc-400 px-2 py-1 rounded-full">{related.data.category}</span>
                <h3 class="text-base font-bold text-zinc-50 mt-3 mb-2 group-hover:text-cyan-400 transition-colors leading-tight">{related.data.title}</h3>
                <p class="text-zinc-500 text-sm">{formatDate(related.data.pubDate)}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.utils.toArray('.reveal-up').forEach((el: any) => {
    gsap.from(el, {
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' },
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out'
    });
  });

  gsap.utils.toArray('.reveal-stagger').forEach((container: any) => {
    gsap.from(container.children, {
      scrollTrigger: { trigger: container, start: 'top 85%' },
      y: 40, opacity: 0, stagger: 0.1, duration: 0.7, ease: 'power3.out'
    });
  });
</script>
