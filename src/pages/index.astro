<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Hero animations
  gsap.from('.hero-eyebrow', { y: 20, opacity: 0, duration: 0.6, ease: 'power3.out', delay: 0.2 });
  gsap.from('.hero-word', { y: 60, opacity: 0, stagger: 0.06, duration: 0.8, ease: 'power4.out', delay: 0.35 });
  gsap.from('.hero-sub', { y: 30, opacity: 0, duration: 0.7, ease: 'power3.out', delay: 0.9 });
  gsap.from('.hero-ctas', { y: 20, opacity: 0, duration: 0.6, ease: 'power3.out', delay: 1.1 });
  gsap.from('.hero-stats', { y: 20, opacity: 0, duration: 0.6, ease: 'power3.out', delay: 1.3 });

  // Knowledge graph animation
  const centralNode = document.getElementById('central-node');
  const graphLines = document.querySelectorAll('#graph-lines line');
  const graphNodes = document.querySelectorAll('.graph-node circle');
  const nodeLabels = document.querySelectorAll('.node-label');

  if (centralNode) {
    // Animate lines
    graphLines.forEach((line, i) => {
      const length = Math.sqrt(
        Math.pow(Number((line as SVGLineElement).getAttribute('x2')) - 250, 2) +
        Math.pow(Number((line as SVGLineElement).getAttribute('y2')) - 250, 2)
      );
      (line as SVGLineElement).style.strokeDasharray = String(length);
      (line as SVGLineElement).style.strokeDashoffset = String(length);
      gsap.to(line, {
        strokeDashoffset: 0,
        duration: 1,
        delay: 0.6 + i * 0.04,
        ease: 'power2.out'
      });
    });

    // Animate nodes
    gsap.from(graphNodes, {
      scale: 0, opacity: 0, stagger: 0.04, duration: 0.4,
      ease: 'back.out(2)', delay: 0.8,
      transformOrigin: 'center center'
    });

    // Labels
    gsap.to(nodeLabels, { opacity: 1, stagger: 0.05, duration: 0.4, delay: 1.5 });

    // Central node
    gsap.to(centralNode, { opacity: 1, duration: 0.6, delay: 1.2, ease: 'power3.out' });
  }

  // ScrollTrigger reveals
  gsap.utils.toArray('.reveal-up').forEach((el: any) => {
    gsap.from(el, {
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' },
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out'
    });
  });

  gsap.utils.toArray('.reveal-stagger').forEach((container: any) => {
    gsap.from(container.children, {
      scrollTrigger: { trigger: container, start: 'top 85%' },
      y: 40, opacity: 0, stagger: 0.1, duration: 0.7, ease: 'power3.out'
    });
  });

  // Count-up
  gsap.utils.toArray('.count-up').forEach((el: any) => {
    const target = parseInt(el.dataset.target);
    const obj = { val: 0 };
    gsap.to(obj, {
      scrollTrigger: { trigger: el, start: 'top 90%' },
      val: target, duration: 2, ease: 'power2.out',
      onUpdate: function() { el.textContent = Math.round(obj.val); }
    });
  });
</script>
