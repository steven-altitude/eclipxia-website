---
import { getCollection } from 'astro:content';
import BaseLayout, { PHONE_DISPLAY, WHATSAPP_URL } from '../layouts/BaseLayout.astro';

// El enlace al blog aparece solo cuando hay al menos un articulo publicado.
const hasBlog = (await getCollection('blog', ({ data }) => !data.draft)).length > 0;

// Casos de éxito: el home muestra los primeros cuatro; el resto vive en /casos/.
const casos = (await getCollection('casos', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
const hasCasos = casos.length > 0;

const MAILTO = 'mailto:hola@eclipxia.com?subject=Consulta%20%E2%80%94%20Eclipxia';
const MAILTO_DIAG = 'mailto:hola@eclipxia.com?subject=Diagn%C3%B3stico%20%E2%80%94%20Eclipxia';

const marqueePhrases = [
  'Cerebros corporativos privados',
  'Agentes de operaciones',
  'IA en tu propio servidor',
  'Auditoría de facturas',
  'Reportes en vivo',
  'Calificación de prospectos',
];
const marqueeLoop = [...marqueePhrases, ...marqueePhrases];

// Los dos servicios principales: lo que vendemos primero y lo que debe quedar claro.
const featured = [
  {
    num: '01',
    title: 'Cerebro corporativo privado',
    promise: 'Una IA que conoce tu empresa por dentro y vive en tu propio servidor.',
    body: 'Le cargamos tus manuales, procedimientos, políticas, contratos, catálogos y bases de datos. Tu equipo pregunta en lenguaje normal y recibe la respuesta correcta al instante, sin buscar entre carpetas ni depender de la persona que "sabe cómo es".',
    points: [
      'Responde con tus documentos y tus datos, no con información genérica de internet.',
      'Cada respuesta cita su fuente, para verificarla en un clic.',
      'Permisos por cargo: cada persona consulta solo lo que le corresponde.',
      'Se mantiene al día: lo actualizamos cada vez que cambia un proceso o un documento.',
    ],
    model: 'Implementación + mantenimiento mensual',
  },
  {
    num: '02',
    title: 'Agentes de IA para tu operación',
    promise: 'IA que no solo responde: ejecuta procesos completos, de principio a fin.',
    body: 'Conectamos el razonamiento de la IA con tus sistemas (ERP, CRM, correo, hojas de cálculo) para que los procesos administrativos de varios pasos avancen solos y tu equipo deje de perder horas en trabajo repetitivo.',
    points: [
      'Auditoría de facturas: cruza cada factura con la orden de compra y marca lo que no cuadra.',
      'Ingreso de personal: documentos, accesos e inducción, con seguimiento automático.',
      'Calificación de prospectos: analiza cada contacto y lo entrega al CRM con el contexto listo.',
      'Reportes en vivo: gerencia pregunta y recibe el informe con datos del día.',
    ],
    model: 'Implementación + mantenimiento mensual',
  },
];

// Servicios de apoyo: preparan el terreno o completan los dos principales.
const services = [
  {
    num: '03',
    title: 'Diagnóstico de IA',
    body: 'Analizamos tus procesos y te decimos dónde la IA ahorra más tiempo y dinero, con un plan priorizado. Es el punto de partida recomendado.',
    meta: 'Entregamos · Casos de uso priorizados · Hoja de ruta',
  },
  {
    num: '04',
    title: 'Capacitación de equipos',
    body: 'Entrenamos a tu equipo para usar IA en su trabajo real, con criterio y sin exponer la información de la empresa.',
    meta: 'Entregamos · Talleres prácticos · Guías internas',
  },
  {
    num: '05',
    title: 'Plataformas a medida',
    body: 'Cuando la herramienta que necesitas no existe, la construimos: portales y paneles internos con IA integrada desde el primer día.',
    meta: 'Entregamos · Portales · Paneles internos',
  },
];

const security = [
  { title: 'En tu propio servidor', body: 'Instalamos la solución en tu nube o en un servidor privado dedicado. Tú decides dónde viven los datos.' },
  { title: 'No entrena IA pública', body: 'Tus documentos y conversaciones no se usan para entrenar modelos de terceros. Siguen siendo tuyos.' },
  { title: 'Acceso por cargo', body: 'Cada usuario consulta solo la información que su rol le permite. Lo confidencial se queda confidencial.' },
  { title: 'Todo queda registrado', body: 'Cada consulta y cada acción de un agente deja rastro: sabes quién preguntó qué y qué hizo la IA.' },
];

const process = [
  { num: '01', title: 'Diagnóstico', body: 'Entendemos tu operación e identificamos dónde la IA genera mayor retorno.' },
  { num: '02', title: 'Diseño', body: 'Definimos la solución, su alcance y los indicadores con los que mediremos el éxito.' },
  { num: '03', title: 'Implementación', body: 'Instalamos la solución en tu infraestructura y la conectamos con tus sistemas y tus equipos.' },
  { num: '04', title: 'Mantenimiento', body: 'Actualizamos su conocimiento, medimos, ajustamos y escalamos lo que funciona.' },
];

const whyUs = [
  { title: 'Velocidad', body: 'Entregamos en semanas lo que un equipo interno tardaría meses en montar.' },
  { title: 'Costo', body: 'Resultados de nivel corporativo a una fracción de contratar y mantener el talento internamente.' },
  { title: 'Enfoque en el negocio', body: 'Hablamos de procesos y resultados, no de tecnología. La IA es el medio, nunca el fin.' },
  { title: 'Ya funciona en empresas reales', body: 'Nuestros sistemas están en producción en empresas de Ecuador. Puedes ver los casos.' },
];

const year = new Date().getFullYear();
---

<BaseLayout>
  <div class="page">
    <!-- scroll progress -->
    <div aria-hidden="true" class="progress" data-progress></div>

    <!-- film grain -->
    <div aria-hidden="true" class="grain"></div>

    <!-- ===================== NAV ===================== -->
    <nav class="nav" data-nav>
      <a href="#top" class="nav-logo" aria-label="Eclipxia inicio">
        <img src="/eclipxia-logo.png" alt="Eclipxia" />
      </a>
      <div class="nav-links">
        <a href="#servicios" class="nav-link">Servicios</a>
        {hasCasos && <a href="/casos/" class="nav-link">Casos</a>}
        <a href="#proceso" class="nav-link">Proceso</a>
        <a href="#nosotros" class="nav-link">Nosotros</a>
        {hasBlog && <a href="/blog/" class="nav-link">Blog</a>}
        <a href={WHATSAPP_URL} class="btn-pill" target="_blank" rel="noopener noreferrer">Contactar</a>
      </div>
      <button type="button" class="nav-burger" data-menu-open aria-label="Abrir menú">
        <span></span><span></span><span></span>
      </button>
    </nav>

    <!-- mobile menu overlay -->
    <div class="mobile-menu" data-mobile-menu>
      <a href="#servicios" data-menu-link>Servicios</a>
      {hasCasos && <a href="/casos/" data-menu-link>Casos</a>}
      <a href="#proceso" data-menu-link>Proceso</a>
      <a href="#nosotros" data-menu-link>Nosotros</a>
      {hasBlog && <a href="/blog/" data-menu-link>Blog</a>}
      <a href="#contacto" data-menu-link>Contacto</a>
      <a href={WHATSAPP_URL} class="mm-btn" target="_blank" rel="noopener noreferrer" data-menu-link>Contactar</a>
      <button type="button" class="mm-close" data-menu-close aria-label="Cerrar menú">&times;</button>
    </div>

    <!-- ===================== HERO ===================== -->
    <header id="top" class="hero">
      <div aria-hidden="true" class="hero-ring">
        <canvas data-ring></canvas>
      </div>
      <div aria-hidden="true" class="hero-vignette"></div>

      <div class="hero-content">
        <div class="eyebrow-pill">
          <span class="dot"></span>
          Consultoría e ingeniería de IA · Ecuador
        </div>
        <h1 data-headline>Inteligencia artificial que mueve a tu empresa.</h1>
        <p class="hero-sub">Construimos IA privada que conoce los documentos, procesos y datos de tu empresa, y agentes que ejecutan el trabajo operativo por tu equipo. Instalada en tu infraestructura, con tu información protegida.</p>
        <div class="hero-cta">
          <a href={WHATSAPP_URL} class="btn-pill-lg" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp &rarr;</a>
          <a href={MAILTO} class="btn-pill-ghost">hola@eclipxia.com</a>
        </div>
      </div>

      <div aria-hidden="true" class="scroll-cue">
        Desplaza
        <span></span>
      </div>
    </header>

    <!-- ===================== MARQUEE ===================== -->
    <section class="marquee-section" aria-hidden="true">
      <div class="marquee">
        {marqueeLoop.map((phrase) => (
          <>
            <span>{phrase}</span><span class="sep">/</span>
          </>
        ))}
      </div>
    </section>

    <!-- ===================== MANIFIESTO ===================== -->
    <section class="section section--manifesto" data-reveal>
      <p class="eyebrow" style="margin-bottom:32px">El planteamiento</p>
      <p class="manifesto-statement" data-highlight>La mayoría de las empresas no necesita más software. Necesita que su información, sus procesos y su gente trabajen mejor.</p>
      <p class="manifesto-follow">Eso es exactamente lo que construimos con inteligencia artificial: sistemas que se integran a tu operación y producen resultados medibles, no proyectos eternos.</p>
    </section>

    <!-- ===================== SERVICIOS ===================== -->
    <section id="servicios" class="section section--servicios" data-reveal>
      <div class="svc-head">
        <div>
          <p class="eyebrow">Servicios</p>
          <h2 class="section-h2">IA privada que conoce tu empresa y trabaja en tu operación.</h2>
        </div>
        <p class="svc-note">Dos servicios principales, diseñados para empresas que no pueden arriesgar su información.</p>
      </div>

      <div class="svc-featured">
        {featured.map((f) => (
          <article class="svc-feature" data-reveal>
            <p class="svc-feature-label"><span class="svc-num">{f.num}</span> Servicio principal</p>
            <h3>{f.title}</h3>
            <p class="svc-feature-promise">{f.promise}</p>
            <p class="svc-feature-body">{f.body}</p>
            <ul class="svc-feature-points">
              {f.points.map((pt) => <li>{pt}</li>)}
            </ul>
            <div class="svc-meta"><p>{f.model}</p></div>
          </article>
        ))}
      </div>

      <p class="eyebrow svc-sub-eyebrow">También hacemos</p>
      <div class="svc-grid">
        {services.map((s) => (
          <article class="svc-card" data-reveal>
            <span class="svc-num">{s.num}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
            <div class="svc-meta"><p>{s.meta}</p></div>
          </article>
        ))}

        <article class="svc-card svc-card--cta" data-reveal>
          <div aria-hidden="true" class="ring-deco r1"></div>
          <div aria-hidden="true" class="ring-deco r2"></div>
          <p class="cta-q">¿No sabes por dónde empezar?</p>
          <a href={MAILTO_DIAG} class="svc-cta-link">Solicita un diagnóstico &rarr;</a>
        </article>
      </div>
    </section>

    <!-- ===================== SEGURIDAD ===================== -->
    <section id="seguridad" class="seguridad" data-reveal>
      <div class="seguridad-inner">
        <div class="seguridad-head">
          <p class="eyebrow">Seguridad y privacidad</p>
          <h2 class="section-h2">Tu información no sale de tu empresa.</h2>
          <p class="svc-note">La primera pregunta de toda gerencia es dónde terminan sus datos. Diseñamos cada solución para que la respuesta sea simple: en tu casa.</p>
        </div>
        <div class="why-grid">
          {security.map((w) => (
            <div class="why-item" data-reveal>
              <div class="rule"></div>
              <h3>{w.title}</h3>
              <p>{w.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== PROCESO ===================== -->
    {hasCasos && (
      <section id="casos" class="home-cases" data-reveal>
        <div class="home-cases-head">
          <div>
            <p class="eyebrow" style="margin-bottom:16px">Casos de éxito</p>
            <h2 class="section-h2">IA que ya está trabajando en empresas reales.</h2>
          </div>
          <a href="/casos/" class="home-cases-link">Ver todos los casos &rarr;</a>
        </div>
        <ul class="case-list">
          {casos.slice(0, 4).map((c) => (
            <li data-reveal>
              <a class="case-card" href={`/casos/${c.id}/`}>
                {c.data.image && (
                  <img class="case-card-img" src={c.data.image} alt={c.data.imageAlt ?? ''} loading="lazy" width="1600" height="1000" />
                )}
                <span class="blog-card-meta">
                  <span>{c.data.client}</span>
                  <span>{c.data.sector}</span>
                </span>
                <span class="blog-card-title">{c.data.title}</span>
                <span class="blog-card-desc">{c.data.summary}</span>
                <span class="blog-card-more" aria-hidden="true">Ver el caso &rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section id="proceso" class="proceso" data-reveal>
      <div class="proceso-inner">
        <p class="eyebrow" style="margin-bottom:16px">Cómo trabajamos</p>
        <h2 class="section-h2 section-head-mb">Un proceso claro, sin promesas vacías.</h2>
        <div class="proc-grid">
          {process.map((p) => (
            <div class="proc-cell" data-reveal>
              <span class="proc-chip">{p.num}</span>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===================== POR QUÉ ===================== -->
    <section class="section section--why why" data-reveal>
      <p class="eyebrow" style="margin-bottom:16px">Por qué Eclipxia</p>
      <h2 class="section-h2 section-head-mb">El impacto de un equipo de IA, sin el costo de construirlo.</h2>
      <div class="why-grid">
        {whyUs.map((w) => (
          <div class="why-item" data-reveal>
            <div class="rule"></div>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ===================== NOSOTROS ===================== -->
    <section id="nosotros" class="nosotros" data-reveal>
      <div class="nosotros-grid">
        <div>
          <p class="eyebrow">Nosotros</p>
          <h2>La IA dejó de ser una promesa. Es una ventaja operativa.</h2>
        </div>
        <div>
          <p class="nosotros-lead">Eclipxia nace de una convicción: la inteligencia artificial se convirtió en una ventaja concreta, y la mayoría de las empresas en Ecuador todavía no sabe cómo capturarla.</p>
          <p class="nosotros-body">Cerramos esa brecha. Combinamos consultoría, ingeniería y formación para que la IA deje de ser un experimento aislado y se vuelva parte de cómo opera tu empresa — con resultados que puedes medir.</p>
        </div>
      </div>
    </section>

    <!-- ===================== CONTACTO ===================== -->
    <section id="contacto" class="contacto" data-reveal>
      <div class="contact-panel">
        <canvas data-ring2 aria-hidden="true"></canvas>
        <div aria-hidden="true" class="contact-overlay"></div>
        <div class="contact-content">
          <p class="eyebrow">Contacto</p>
          <h2>Hablemos de tu empresa.</h2>
          <p>Cuéntanos qué proceso quieres mejorar y te respondemos con una propuesta concreta.</p>
          <div class="hero-cta">
            <a href={WHATSAPP_URL} class="btn-pill-lg" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp &rarr;</a>
            <a href={MAILTO} class="btn-pill-ghost">hola@eclipxia.com</a>
          </div>
          <p class="contact-phone">
            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">{PHONE_DISPLAY}</a>
          </p>
        </div>
      </div>
    </section>

    <!-- ===================== FOOTER ===================== -->
    <footer class="footer">
      <div class="footer-top">
        <div class="footer-brand">
          <img src="/eclipxia-logo.png" alt="Eclipxia — Inteligencia artificial para empresas en Ecuador" />
          <p>Inteligencia artificial aplicada a los problemas reales de tu empresa.</p>
        </div>
        <div class="footer-meta">
          <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">WhatsApp {PHONE_DISPLAY}</a>
          <a href={MAILTO}>hola@eclipxia.com</a>
          <p>Edificio Xima. Piso 2. Oficina 218.<br />Samborondón, Ecuador.</p>
        </div>
      </div>
      <div class="footer-bottom">
        <div class="footer-bottom-inner">
          <span>&copy; {year} Eclipxia</span>
          <span>Inteligencia artificial para empresas</span>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<script>
  // ---------------------------------------------------------------
  // Eclipxia landing — interactions
  // ---------------------------------------------------------------
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Nav frosted state on scroll ----
  const nav = document.querySelector('[data-nav]');
  const onNavScroll = () => {
    if (!nav) return;
    nav.classList.toggle('scrolled', window.scrollY > 24);
  };
  window.addEventListener('scroll', onNavScroll, { passive: true });
  onNavScroll();

  // ---- Mobile menu ----
  const menu = document.querySelector('[data-mobile-menu]');
  const openBtn = document.querySelector('[data-menu-open]');
  const closeMenu = () => menu && menu.classList.remove('open');
  openBtn && openBtn.addEventListener('click', () => menu && menu.classList.add('open'));
  document.querySelectorAll('[data-menu-close], [data-menu-link]').forEach((el) =>
    el.addEventListener('click', closeMenu)
  );

  // ---- Scroll reveal with per-sibling stagger ----
  const revealEls = Array.from(document.querySelectorAll('[data-reveal]'));
  if ('IntersectionObserver' in window) {
    revealEls.forEach((el) => {
      const parent = el.parentElement;
      const sibs = parent ? Array.from(parent.querySelectorAll(':scope > [data-reveal]')) : [el];
      const idx = Math.max(0, sibs.indexOf(el));
      (el as HTMLElement).style.transitionDelay = idx * 0.09 + 's';
    });
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    revealEls.forEach((el) => io.observe(el));
  } else {
    revealEls.forEach((el) => el.classList.add('is-visible'));
  }

  // ---- Kinetic headline ----
  const h1 = document.querySelector('[data-headline]') as HTMLElement | null;
  if (h1 && !h1.dataset.kinetic) {
    h1.dataset.kinetic = '1';
    const words = (h1.textContent || '').trim().split(/\s+/);
    h1.textContent = '';
    words.forEach((w, i) => {
      const inner = document.createElement('span');
      inner.textContent = w;
      inner.style.animation = 'ecl-word .9s cubic-bezier(.16,1,.3,1) ' + (0.1 + i * 0.08).toFixed(3) + 's both';
      h1.appendChild(inner);
      if (i < words.length - 1) h1.appendChild(document.createTextNode(' '));
    });
  }
  // Failsafe: force hero text visible if animations never advance
  setTimeout(() => {
    if (h1)
      h1.querySelectorAll('span').forEach((sp) => {
        const s = sp as HTMLElement;
        s.style.animation = 'none';
        s.style.opacity = '1';
        s.style.transform = 'none';
        s.style.filter = 'none';
      });
  }, 2000);

  // ---- Progressive manifesto highlight ----
  const mani = document.querySelector('[data-highlight]') as HTMLElement | null;
  let maniSpans: HTMLElement[] = [];
  if (mani) {
    const words = (mani.textContent || '').trim().split(/\s+/);
    mani.textContent = '';
    words.forEach((w, i) => {
      const span = document.createElement('span');
      span.textContent = w;
      span.style.color = '#3A3B42';
      mani.appendChild(span);
      if (i < words.length - 1) mani.appendChild(document.createTextNode(' '));
      maniSpans.push(span);
    });
  }

  // ---- Scroll progress bar + manifesto highlight on scroll ----
  const progress = document.querySelector('[data-progress]') as HTMLElement | null;
  const onProgress = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight || 1;
    const pct = Math.min(100, Math.max(0, (window.scrollY / max) * 100));
    if (progress) progress.style.width = pct + '%';
    if (maniSpans.length && mani) {
      const r = mani.getBoundingClientRect();
      const vh = window.innerHeight;
      const start = vh * 0.85,
        end = vh * 0.35;
      let p = (start - r.top) / (start - end);
      p = Math.min(1, Math.max(0, p));
      const lit = Math.round(p * maniSpans.length);
      maniSpans.forEach((s, i) => {
        s.style.color = i < lit ? '#F2F2F4' : '#3A3B42';
      });
    }
  };
  window.addEventListener('scroll', onProgress, { passive: true });
  onProgress();

  // ---- Eclipse ring canvas ----
  function initRing(canvas: HTMLCanvasElement | null, interactive: boolean) {
    if (!canvas) return null;
    const ctx = canvas.getContext('2d');
    const host = canvas.parentElement;
    if (!ctx || !host) return null;
    const DPR = Math.min(window.devicePixelRatio || 1, 2);
    let W = 0,
      H = 0;
    const o: any = { raf: 0, interval: 0, sizeRaf: 0, mx: 0, my: 0, tmx: 0, tmy: 0 };

    const resize = () => {
      const r = host.getBoundingClientRect();
      if (r.width < 2 || r.height < 2) return false;
      W = r.width;
      H = r.height;
      canvas.width = Math.round(W * DPR);
      canvas.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      return true;
    };
    const ensureSize = () => {
      if (!resize()) o.sizeRaf = requestAnimationFrame(ensureSize);
    };
    ensureSize();
    window.addEventListener('resize', resize);

    if (interactive) {
      const onMove = (e: MouseEvent) => {
        o.tmx = (e.clientX / window.innerWidth - 0.5) * 2;
        o.tmy = (e.clientY / window.innerHeight - 0.5) * 2;
      };
      window.addEventListener('mousemove', onMove, { passive: true });
    }

    const guides = [0.52, 0.7, 0.86, 1.0];
    let t = 0;
    const render = () => {
      if (W < 2 || H < 2) {
        if (!resize()) return;
      }
      o.mx += (o.tmx - o.mx) * 0.05;
      o.my += (o.tmy - o.my) * 0.05;
      t += reduce ? 0 : 0.016;
      ctx.clearRect(0, 0, W, H);
      const cx = W / 2 + o.mx * 14;
      const cy = H / 2 + o.my * 14;
      const R = Math.min(W, H) * 0.42;

      const breathe = 0.5 + 0.5 * Math.sin(t * 0.5);
      const glow = ctx.createRadialGradient(cx, cy, 0, cx, cy, R * 1.05);
      glow.addColorStop(0, 'rgba(210,214,224,' + (0.05 + breathe * 0.05).toFixed(3) + ')');
      glow.addColorStop(0.55, 'rgba(150,156,170,' + (0.02 + breathe * 0.02).toFixed(3) + ')');
      glow.addColorStop(1, 'rgba(150,156,170,0)');
      ctx.fillStyle = glow;
      ctx.beginPath();
      ctx.arc(cx, cy, R * 1.05, 0, Math.PI * 2);
      ctx.fill();

      ctx.lineWidth = 1;
      guides.forEach((g, i) => {
        ctx.beginPath();
        ctx.arc(cx, cy, R * g, 0, Math.PI * 2);
        ctx.strokeStyle = 'rgba(255,255,255,' + (0.05 - i * 0.008).toFixed(3) + ')';
        ctx.stroke();
      });

      const drawSweep = (radius: number, headAngle: number, span: number, maxAlpha: number, width: number) => {
        const segs = 140;
        ctx.lineWidth = width;
        ctx.lineCap = 'round';
        for (let s = 0; s < segs; s++) {
          const a0 = (s / segs) * Math.PI * 2;
          let dd = (headAngle - a0) % (Math.PI * 2);
          if (dd < 0) dd += Math.PI * 2;
          if (dd > span) continue;
          const fall = 1 - dd / span;
          const alpha = maxAlpha * Math.pow(fall, 1.6);
          if (alpha < 0.004) continue;
          const a1 = ((s + 1) / segs) * Math.PI * 2;
          ctx.beginPath();
          ctx.arc(cx, cy, radius, a0, a1);
          ctx.strokeStyle = 'rgba(248,249,252,' + alpha.toFixed(3) + ')';
          ctx.stroke();
        }
      };
      const head = (t * 0.42) % (Math.PI * 2);
      drawSweep(R, head, Math.PI * 1.25, 0.85, 1.6);
      const head2 = (((-t * 0.3) % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2);
      drawSweep(R * 0.7, head2, Math.PI * 0.9, 0.3, 1.2);

      const hx = cx + Math.cos(head) * R,
        hy = cy + Math.sin(head) * R;
      const hp = ctx.createRadialGradient(hx, hy, 0, hx, hy, 16);
      hp.addColorStop(0, 'rgba(255,255,255,.9)');
      hp.addColorStop(0.4, 'rgba(255,255,255,.35)');
      hp.addColorStop(1, 'rgba(255,255,255,0)');
      ctx.fillStyle = hp;
      ctx.beginPath();
      ctx.arc(hx, hy, 16, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = 'rgba(255,255,255,.95)';
      ctx.beginPath();
      ctx.arc(hx, hy, 2.2, 0, Math.PI * 2);
      ctx.fill();
    };

    const loop = () => {
      o.raf = requestAnimationFrame(loop);
      render();
    };
    loop();
    o.interval = window.setInterval(() => {
      if (document.hidden) render();
    }, 200);
    return o;
  }

  initRing(document.querySelector('[data-ring]'), true);
  initRing(document.querySelector('[data-ring2]'), false);
</script>
