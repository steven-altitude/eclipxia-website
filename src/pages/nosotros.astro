---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Sobre Eclipxia",
  "url": "https://www.eclipxia.com/nosotros/",
  "description": "Eclipxia es una consultora de implementación de IA empresarial con sede en América Latina",
  "mainEntity": {
    "@type": "Organization",
    "name": "Eclipxia",
    "foundingDate": "2024",
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 10 },
    "knowsAbout": ["Inteligencia Artificial", "RAG", "LLM", "Automatización Empresarial", "AnythingLLM", "Claude AI"]
  }
};
---

<BaseLayout
  title="Nosotros | Eclipxia — Equipo de Implementación IA Empresarial"
  description="Conoce al equipo de Eclipxia. Especialistas en implementación de IA empresarial para organizaciones en América Latina que quieren pasar del piloto a producción."
  activePage="nosotros"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="min-h-[60dvh] flex items-center pt-16 bg-zinc-950 overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 w-full py-20">
      <div class="grid lg:grid-cols-[55fr_45fr] gap-16 items-center">
        <div>
          <span class="text-xs font-semibold tracking-[0.25em] text-cyan-400 uppercase block mb-6 hero-eyebrow">Nosotros</span>
          <h1 class="text-4xl lg:text-5xl xl:text-6xl font-black tracking-tight leading-[1.05]">
            <span class="hero-word">Construimos</span>
            <span class="hero-word"> IA</span>
            <span class="hero-word"> que</span>
            <br />
            <span class="hero-word">sobrevive</span>
            <span class="hero-word"> al</span>
            <span class="hero-word"> <span class="text-cyan-400">lunes</span></span>
            <br />
            <span class="hero-word">siguiente</span>
            <span class="hero-word"> al</span>
            <span class="hero-word"> lanzamiento.</span>
          </h1>
        </div>
        <!-- Dot Grid Visual -->
        <div class="hidden lg:block">
          <div id="dot-grid" class="dot-grid w-full max-w-xs ml-auto"></div>
          <p class="text-xs text-zinc-600 mt-4 text-right">El conocimiento de su empresa, conectado.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="bg-zinc-900 py-24">
    <div class="max-w-[900px] mx-auto px-6 lg:px-10 text-center">
      <blockquote class="reveal-up">
        <p class="text-2xl lg:text-3xl xl:text-4xl font-light text-zinc-200 leading-relaxed italic">
          &ldquo;La mayor&iacute;a de los proyectos de IA mueren porque nadie en la empresa sabe qu&eacute; hacer el lunes despu&eacute;s del demo. Nosotros empezamos desde ese lunes.&rdquo;
        </p>
        <footer class="mt-8 flex items-center justify-center gap-3">
          <div class="w-8 h-px bg-cyan-400"></div>
          <span class="text-sm text-cyan-400 font-medium tracking-wide">Equipo Eclipxia</span>
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- COMPANY STORY -->
  <section class="bg-zinc-950 py-28 relative overflow-hidden">
    <div class="absolute right-0 top-1/2 -translate-y-1/2 text-[180px] lg:text-[240px] font-black text-zinc-900 leading-none select-none pointer-events-none blur-sm pr-10 opacity-60">2024</div>
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 relative z-10">
      <div class="max-w-[680px]">
        <span class="text-xs font-semibold tracking-[0.25em] text-cyan-400 uppercase block mb-8">Nuestra historia</span>
        <div class="space-y-8">
          <p class="reveal-up text-lg text-zinc-300 leading-relaxed">
            Eclipxia naci&oacute; de una frustraci&oacute;n compartida: ver c&oacute;mo empresas con datos reales, problemas reales y presupuestos reales terminaban con proyectos de IA que nadie usaba. Consultoras de nombre que entregaban PowerPoints. Vendors que desaparec&iacute;an despu&eacute;s del piloto.
          </p>
          <p class="reveal-up text-lg text-zinc-300 leading-relaxed">
            Somos ingenieros que venimos de trabajar dentro de empresas medianas y grandes en Am&eacute;rica Latina. Conocemos la diferencia entre un sistema en sandbox y uno que sobrevive a los lunes. A los cambios de prioridad. A los IT que no aprobaron el acceso. A los usuarios que no entienden la interfaz.
          </p>
          <p class="reveal-up text-lg text-zinc-300 leading-relaxed">
            Cada implementaci&oacute;n que entregamos pasa por una sola prueba: <span class="text-zinc-50 font-medium">&iquest;Funciona en producci&oacute;n cuando nadie del equipo de implementaci&oacute;n est&aacute; mirando?</span> Si la respuesta es no, no hemos terminado.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="bg-zinc-900/60 py-28">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      <span class="text-xs font-semibold tracking-[0.25em] text-cyan-400 uppercase block mb-8 reveal-up">Lo que nos gu&iacute;a</span>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 reveal-stagger">
        <!-- Large featured value -->
        <div class="value-card lg:col-span-2 bg-cyan-950/20 border border-cyan-400/20 p-10 rounded-2xl">
          <div class="w-12 h-12 rounded-xl bg-cyan-400/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <h3 class="text-2xl font-bold text-zinc-50 mb-4">Producci&oacute;n o no cuenta</h3>
          <p class="text-zinc-400 leading-relaxed text-lg">
            No medimos &eacute;xito en demos impresionantes, pilots aprobados ni presentaciones aplaudidas. Solo nos importa una m&eacute;trica: &iquest;est&aacute; corriendo en producci&oacute;n y la gente lo usa? Todo lo dem&aacute;s es output intermedio.
          </p>
        </div>
        <div class="value-card bg-zinc-900 border border-zinc-800 p-8 rounded-2xl">
          <div class="w-12 h-12 rounded-xl bg-zinc-800 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </div>
          <h3 class="text-lg font-bold text-zinc-50 mb-3">Ingenier&iacute;a, no magia</h3>
          <p class="text-zinc-400 leading-relaxed text-sm">Explicamos exactamente qu&eacute; hace el sistema, por qu&eacute; funciona y qu&eacute; puede fallar. Sin cajas negras. Sin dependencia artificial.</p>
        </div>
        <div class="value-card bg-zinc-900 border border-zinc-800 p-8 rounded-2xl">
          <div class="w-12 h-12 rounded-xl bg-zinc-800 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-zinc-50 mb-3">Transferencia real</h3>
          <p class="text-zinc-400 leading-relaxed text-sm">El objetivo es que su equipo opere el sistema sin nosotros. Documentamos, capacitamos y salimos. Esa es la se&ntilde;al de que hicimos bien el trabajo.</p>
        </div>
        <div class="value-card lg:col-span-2 bg-zinc-900 border border-zinc-800 p-8 rounded-2xl">
          <div class="w-12 h-12 rounded-xl bg-zinc-800 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-zinc-50 mb-3">Sus datos, su infraestructura</h3>
          <p class="text-zinc-400 leading-relaxed">Los datos de su empresa no salen de su infraestructura a menos que usted lo autorice expl&iacute;citamente. No compartimos datos entre clientes. No usamos su informaci&oacute;n para entrenar modelos propios.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NUMBERS STRIP -->
  <section class="bg-zinc-900 border-y border-zinc-800 py-16">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 reveal-stagger">
        <div class="text-center">
          <div class="text-5xl lg:text-6xl font-black text-cyan-400">8</div>
          <div class="text-sm text-zinc-400 mt-2">servicios especializados</div>
        </div>
        <div class="text-center">
          <div class="text-5xl lg:text-6xl font-black text-cyan-400">100%</div>
          <div class="text-sm text-zinc-400 mt-2">datos en su infraestructura</div>
        </div>
        <div class="text-center">
          <div class="text-5xl lg:text-6xl font-black text-cyan-400">0</div>
          <div class="text-sm text-zinc-400 mt-2">lock-in de vendor</div>
        </div>
        <div class="text-center">
          <div class="text-5xl lg:text-6xl font-black text-cyan-400">24/7</div>
          <div class="text-sm text-zinc-400 mt-2">disponibilidad del sistema</div>
        </div>
      </div>
    </div>
  </section>

  <!-- TEAM -->
  <section class="bg-zinc-950 py-28">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      <div class="mb-14">
        <span class="text-xs font-semibold tracking-[0.25em] text-cyan-400 uppercase block mb-4 reveal-up">El equipo</span>
        <h2 class="reveal-up text-4xl lg:text-5xl font-black tracking-tight">
          Ingenieros que han enviado a producci&oacute;n.<br /><span class="text-zinc-500">No solo a GitHub.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-6 reveal-stagger">
        <!-- Team member 1 — large card -->
        <div class="team-card lg:col-span-4 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="h-56 overflow-hidden">
            <img src="https://picsum.photos/seed/ceo-eclipxia/400/300" alt="Director de Implementaci&oacute;n" class="w-full h-full object-cover grayscale opacity-80" />
          </div>
          <div class="p-7">
            <div class="text-xs font-semibold tracking-widest text-cyan-400 uppercase mb-2">Fundador</div>
            <h3 class="text-xl font-bold text-zinc-50">Rodrigo Almeida</h3>
            <p class="text-zinc-400 text-sm mt-1 mb-4">Director de Implementaci&oacute;n</p>
            <p class="text-zinc-500 text-sm leading-relaxed">12 a&ntilde;os en arquitectura de datos. Ha implementado sistemas en 4 sectores distintos: log&iacute;stica, finanzas, manufactura y salud.</p>
            <div class="mt-5 flex gap-3">
              <a href="https://linkedin.com/company/eclipxia" class="w-8 h-8 rounded-lg bg-zinc-800 flex items-center justify-center hover:bg-zinc-700 transition-colors" aria-label="LinkedIn">
                <svg class="w-4 h-4 text-zinc-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
            </div>
          </div>
        </div>
        <!-- Team member 2 -->
        <div class="team-card lg:col-span-3 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="h-44 overflow-hidden">
            <img src="https://picsum.photos/seed/cto-eclipxia/400/300" alt="Arquitecta de IA" class="w-full h-full object-cover grayscale opacity-80" />
          </div>
          <div class="p-6">
            <div class="text-xs font-semibold tracking-widest text-cyan-400 uppercase mb-2">Co-fundadora</div>
            <h3 class="text-lg font-bold text-zinc-50">Valentina Cruz</h3>
            <p class="text-zinc-400 text-sm mt-1 mb-3">Arquitecta de IA</p>
            <p class="text-zinc-500 text-sm leading-relaxed">Especialista en RAG y sistemas de recuperaci&oacute;n de informaci&oacute;n a escala enterprise.</p>
          </div>
        </div>
        <!-- Team member 3 -->
        <div class="team-card lg:col-span-3 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="h-44 overflow-hidden">
            <img src="https://picsum.photos/seed/engineer-eclipxia/400/300" alt="Ingeniero de Integraciones" class="w-full h-full object-cover grayscale opacity-80" />
          </div>
          <div class="p-6">
            <div class="text-xs font-semibold tracking-widest text-zinc-600 uppercase mb-2">Equipo</div>
            <h3 class="text-lg font-bold text-zinc-50">Marco Herrera</h3>
            <p class="text-zinc-400 text-sm mt-1 mb-3">Ingeniero de Integraciones</p>
            <p class="text-zinc-500 text-sm leading-relaxed">Conecta los sistemas de IA con ERP, CRM y bases de datos legacy sin romper nada.</p>
          </div>
        </div>
        <!-- Team member 4 — narrow card -->
        <div class="team-card lg:col-span-2 bg-zinc-900 border border-zinc-800 rounded-2xl overflow-hidden">
          <div class="h-36 overflow-hidden">
            <img src="https://picsum.photos/seed/pm-eclipxia/300/200" alt="Estrategia y Clientes" class="w-full h-full object-cover grayscale opacity-80" />
          </div>
          <div class="p-5">
            <div class="text-xs font-semibold tracking-widest text-zinc-600 uppercase mb-2">Equipo</div>
            <h3 class="text-base font-bold text-zinc-50">Ana Restrepo</h3>
            <p class="text-zinc-400 text-xs mt-1">Estrategia Enterprise</p>
          </div>
        </div>
      </div>

      <div class="mt-12 reveal-up">
        <div class="bg-zinc-900/50 border border-zinc-800 rounded-2xl p-8 max-w-2xl">
          <h3 class="text-lg font-bold text-zinc-50 mb-3">Trabaja con nosotros</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-5">Buscamos ingenieros que prefieran ver sus sistemas corriendo en producci&oacute;n a acumular stars en GitHub. Si eso te suena, hablemos.</p>
          <a href="/contacto/" class="inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 transition-colors text-sm font-medium">
            Enviar propuesta
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Hero animations
  gsap.from('.hero-eyebrow', { y: 20, opacity: 0, duration: 0.6, ease: 'power3.out', delay: 0.2 });
  gsap.from('.hero-word', { y: 60, opacity: 0, stagger: 0.06, duration: 0.8, ease: 'power4.out', delay: 0.35 });

  // Dot grid
  const dotGrid = document.getElementById('dot-grid');
  if (dotGrid) {
    const totalDots = 64;
    const litIndices = new Set<number>();
    while (litIndices.size < 43) {
      litIndices.add(Math.floor(Math.random() * totalDots));
    }
    for (let i = 0; i < totalDots; i++) {
      const dot = document.createElement('div');
      dot.className = 'dot' + (litIndices.has(i) ? ' lit' : '');
      if (litIndices.has(i)) {
        dot.style.animationDelay = Math.random() * 3 + 's';
        dot.classList.add('dot-active');
      }
      dotGrid.appendChild(dot);
    }
    gsap.from('.dot', { scale: 0, opacity: 0, stagger: 0.02, duration: 0.4, ease: 'back.out(2)', delay: 0.6 });
  }

  // ScrollTrigger reveals
  gsap.utils.toArray('.reveal-up').forEach((el: any) => {
    gsap.from(el, {
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' },
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out'
    });
  });

  gsap.utils.toArray('.reveal-stagger').forEach((container: any) => {
    gsap.from(container.children, {
      scrollTrigger: { trigger: container, start: 'top 85%' },
      y: 40, opacity: 0, stagger: 0.1, duration: 0.7, ease: 'power3.out'
    });
  });

  // Count-up
  gsap.utils.toArray('.count-up').forEach((el: any) => {
    const target = parseInt(el.dataset.target);
    const obj = { val: 0 };
    gsap.to(obj, {
      scrollTrigger: { trigger: el, start: 'top 90%' },
      val: target, duration: 2, ease: 'power2.out',
      onUpdate: function() { el.textContent = Math.round(obj.val); }
    });
  });
</script>
