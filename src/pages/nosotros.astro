---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Sobre Eclipxia",
  "url": "https://www.eclipxia.com/nosotros/",
  "description": "Eclipxia es una consultora de implementación de IA empresarial con sede en América Latina",
  "mainEntity": {
    "@type": "Organization",
    "name": "Eclipxia",
    "foundingDate": "2024",
    "numberOfEmployees": { "@type": "QuantitativeValue", "value": 10 },
    "knowsAbout": ["Inteligencia Artificial", "RAG", "LLM", "Automatización Empresarial", "AnythingLLM", "Claude AI"]
  }
};
---

<BaseLayout
  title="Nosotros | Eclipxia — Equipo de Implementación IA Empresarial"
  description="Conoce al equipo de Eclipxia. Especialistas en implementación de IA empresarial para organizaciones en América Latina que quieren pasar del piloto a producción."
  activePage="nosotros"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="min-h-[60dvh] flex items-center pt-16 bg-zinc-950 overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 w-full py-20">
      <div class="grid lg:grid-cols-[55fr_45fr] gap-16 items-center">
        <div>
          <span class="text-xs font-semibold tracking-[0.25em] text-cyan-400 uppercase block mb-6 hero-eyebrow">Nosotros</span>
          <h1 class="text-4xl lg:text-5xl xl:text-6xl font-black tracking-tight leading-[1.05]">
            <span class="hero-word">IA que</span>
            <span class="hero-word"> se</span>
            <span class="hero-word"> usa.</span>
            <br />
            <span class="hero-word">No que</span>
            <span class="hero-word"> se</span>
            <br />
            <span class="hero-word"><span class="text-cyan-400">presenta.</span></span>
          </h1>
        </div>
        <!-- Data flow SVG -->
        <div class="hidden lg:block">
          <svg id="data-flow" viewBox="0 0 360 400" class="w-full max-w-xs ml-auto" aria-hidden="true">
            <defs>
              <filter id="df-glow">
                <feGaussianBlur stdDeviation="3" result="blur"/>
                <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
            </defs>
            <!-- Spoke lines from center to each source node -->
            <g id="df-lines">
              <line x1="180" y1="200" x2="180" y2="55"  stroke="#3f3f46" stroke-width="1"/>
              <line x1="180" y1="200" x2="306" y2="128" stroke="#3f3f46" stroke-width="1"/>
              <line x1="180" y1="200" x2="306" y2="273" stroke="#3f3f46" stroke-width="1"/>
              <line x1="180" y1="200" x2="180" y2="345" stroke="#3f3f46" stroke-width="1"/>
              <line x1="180" y1="200" x2="54"  y2="273" stroke="#3f3f46" stroke-width="1"/>
              <line x1="180" y1="200" x2="54"  y2="128" stroke="#3f3f46" stroke-width="1"/>
            </g>
            <!-- Source nodes (hexagonal layout, radius 145 from center 180,200) -->
            <g id="df-nodes">
              <g class="df-node">
                <circle cx="180" cy="55"  r="9" fill="#27272a" stroke="#52525b" stroke-width="1.5"/>
                <text x="180" y="37" text-anchor="middle" fill="#71717a" font-size="9.5" font-family="Satoshi, sans-serif">Documentos</text>
              </g>
              <g class="df-node">
                <circle cx="306" cy="128" r="9" fill="#27272a" stroke="#52525b" stroke-width="1.5"/>
                <text x="322" y="132" text-anchor="start" fill="#71717a" font-size="9.5" font-family="Satoshi, sans-serif">Legal</text>
              </g>
              <g class="df-node">
                <circle cx="306" cy="273" r="9" fill="#27272a" stroke="#52525b" stroke-width="1.5"/>
                <text x="322" y="277" text-anchor="start" fill="#71717a" font-size="9.5" font-family="Satoshi, sans-serif">Finanzas</text>
              </g>
              <g class="df-node">
                <circle cx="180" cy="345" r="9" fill="#27272a" stroke="#52525b" stroke-width="1.5"/>
                <text x="180" y="363" text-anchor="middle" fill="#71717a" font-size="9.5" font-family="Satoshi, sans-serif">RRHH</text>
              </g>
              <g class="df-node">
                <circle cx="54" cy="273"  r="9" fill="#27272a" stroke="#52525b" stroke-width="1.5"/>
                <text x="38" y="277" text-anchor="end" fill="#71717a" font-size="9.5" font-family="Satoshi, sans-serif">Contratos</text>
              </g>
              <g class="df-node">
                <circle cx="54" cy="128"  r="9" fill="#27272a" stroke="#52525b" stroke-width="1.5"/>
                <text x="38" y="132" text-anchor="end" fill="#71717a" font-size="9.5" font-family="Satoshi, sans-serif">Procesos</text>
              </g>
            </g>
            <!-- Central IA node -->
            <g id="df-center" opacity="0">
              <circle id="df-ring-1" cx="180" cy="200" r="32" fill="none" stroke="#00D4FF" stroke-width="1.5" opacity="0"/>
              <circle id="df-ring-2" cx="180" cy="200" r="32" fill="none" stroke="#00D4FF" stroke-width="1"   opacity="0"/>
              <circle cx="180" cy="200" r="32" fill="#00D4FF08" stroke="#00D4FF25" stroke-width="1.5"/>
              <circle cx="180" cy="200" r="22" fill="#00D4FF" filter="url(#df-glow)"/>
              <text x="180" y="204" text-anchor="middle" fill="#09090b" font-size="10" font-weight="700" font-family="Satoshi, sans-serif">IA</text>
            </g>
            <!-- Particles container -->
            <g id="df-particles"></g>
          </svg>
          <p class="text-xs text-zinc-600 mt-4 text-right">Sus datos, fluyendo hacia la IA.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- MANIFESTO -->
  <section class="bg-zinc-900 py-24">
    <div class="max-w-[900px] mx-auto px-6 lg:px-10 text-center">
      <blockquote class="reveal-up">
        <p class="text-2xl lg:text-3xl xl:text-4xl font-light text-zinc-200 leading-relaxed italic">
          &ldquo;El problema no es la tecnolog&iacute;a. Es que nadie dise&ntilde;&oacute; c&oacute;mo esa tecnolog&iacute;a iba a vivir dentro de la empresa. Eso es lo que nosotros resolvemos.&rdquo;
        </p>
        <footer class="mt-8 flex items-center justify-center gap-3">
          <div class="w-8 h-px bg-cyan-400"></div>
          <span class="text-sm text-cyan-400 font-medium tracking-wide">Equipo Eclipxia</span>
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- COMPANY STORY -->
  <section class="bg-zinc-950 py-28 relative overflow-hidden">
    <div class="absolute right-0 top-1/2 -translate-y-1/2 text-[180px] lg:text-[240px] font-black text-zinc-900 leading-none select-none pointer-events-none blur-sm pr-10 opacity-60">2024</div>
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 relative z-10">
      <div class="max-w-[680px]">
        <span class="text-xs font-semibold tracking-[0.25em] text-cyan-400 uppercase block mb-8">Nuestra historia</span>
        <div class="space-y-8">
          <p class="reveal-up text-lg text-zinc-300 leading-relaxed">
            Eclipxia naci&oacute; de una frustraci&oacute;n compartida: ver c&oacute;mo empresas con datos reales, problemas reales y presupuestos reales terminaban con proyectos de IA que nadie usaba. Consultoras de nombre que entregaban PowerPoints. Vendors que desaparec&iacute;an despu&eacute;s del piloto.
          </p>
          <p class="reveal-up text-lg text-zinc-300 leading-relaxed">
            Somos ingenieros con experiencia dentro de empresas medianas y grandes en Am&eacute;rica Latina. Conocemos la diferencia entre un sistema en sandbox y uno que funciona bajo presi&oacute;n real: cambios de prioridad, integraciones que no estaban en el scope, usuarios que nunca pidieron el sistema.
          </p>
          <p class="reveal-up text-lg text-zinc-300 leading-relaxed">
            Cada implementaci&oacute;n que entregamos pasa por una sola prueba: <span class="text-zinc-50 font-medium">&iquest;Funciona en producci&oacute;n cuando nadie del equipo de implementaci&oacute;n est&aacute; mirando?</span> Si la respuesta es no, no hemos terminado.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUES -->
  <section class="bg-zinc-900/60 py-28">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      <span class="text-xs font-semibold tracking-[0.25em] text-cyan-400 uppercase block mb-8 reveal-up">Lo que nos gu&iacute;a</span>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 reveal-stagger">
        <!-- Featured value -->
        <div class="value-card bg-cyan-950/20 border border-cyan-400/20 p-8 rounded-2xl">
          <div class="w-12 h-12 rounded-xl bg-cyan-400/10 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <h3 class="text-2xl font-bold text-zinc-50 mb-4">Producci&oacute;n o no cuenta</h3>
          <p class="text-zinc-400 leading-relaxed text-sm">
            No medimos &eacute;xito en demos impresionantes, pilots aprobados ni presentaciones aplaudidas. Solo nos importa una m&eacute;trica: &iquest;est&aacute; corriendo en producci&oacute;n y la gente lo usa? Todo lo dem&aacute;s es output intermedio.
          </p>
        </div>
        <div class="value-card bg-zinc-900 border border-zinc-800 p-8 rounded-2xl">
          <div class="w-12 h-12 rounded-xl bg-zinc-800 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </div>
          <h3 class="text-lg font-bold text-zinc-50 mb-3">Ingenier&iacute;a, no magia</h3>
          <p class="text-zinc-400 leading-relaxed text-sm">Explicamos exactamente qu&eacute; hace el sistema, por qu&eacute; funciona y qu&eacute; puede fallar. Sin cajas negras. Sin dependencia artificial.</p>
        </div>
        <div class="value-card bg-zinc-900 border border-zinc-800 p-8 rounded-2xl">
          <div class="w-12 h-12 rounded-xl bg-zinc-800 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-zinc-50 mb-3">Transferencia real</h3>
          <p class="text-zinc-400 leading-relaxed text-sm">El objetivo es que su equipo opere el sistema sin nosotros. Documentamos, capacitamos y salimos. Esa es la se&ntilde;al de que hicimos bien el trabajo.</p>
        </div>
        <div class="value-card bg-zinc-900 border border-zinc-800 p-8 rounded-2xl">
          <div class="w-12 h-12 rounded-xl bg-zinc-800 flex items-center justify-center mb-6">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          </div>
          <h3 class="text-lg font-bold text-zinc-50 mb-3">Sus datos, su infraestructura</h3>
          <p class="text-zinc-400 leading-relaxed">Los datos de su empresa no salen de su infraestructura a menos que usted lo autorice expl&iacute;citamente. No compartimos datos entre clientes. No usamos su informaci&oacute;n para entrenar modelos propios.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- NUMBERS STRIP -->
  <section class="bg-zinc-900 border-y border-zinc-800 py-16">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 reveal-stagger">
        <div class="text-center group cursor-default">
          <div class="text-5xl lg:text-6xl font-black text-cyan-400 transition-all duration-300 group-hover:text-white group-hover:[text-shadow:0_0_28px_#00d4ff]">8</div>
          <div class="text-sm text-zinc-400 mt-2 transition-colors duration-300 group-hover:text-zinc-200">servicios especializados</div>
        </div>
        <div class="text-center group cursor-default">
          <div class="text-5xl lg:text-6xl font-black text-cyan-400 transition-all duration-300 group-hover:text-white group-hover:[text-shadow:0_0_28px_#00d4ff]">100%</div>
          <div class="text-sm text-zinc-400 mt-2 transition-colors duration-300 group-hover:text-zinc-200">datos en su infraestructura</div>
        </div>
        <div class="text-center group cursor-default">
          <div class="text-5xl lg:text-6xl font-black text-cyan-400 transition-all duration-300 group-hover:text-white group-hover:[text-shadow:0_0_28px_#00d4ff]">0</div>
          <div class="text-sm text-zinc-400 mt-2 transition-colors duration-300 group-hover:text-zinc-200">lock-in de vendor</div>
        </div>
        <div class="text-center group cursor-default">
          <div class="text-5xl lg:text-6xl font-black text-cyan-400 transition-all duration-300 group-hover:text-white group-hover:[text-shadow:0_0_28px_#00d4ff]">24/7</div>
          <div class="text-sm text-zinc-400 mt-2 transition-colors duration-300 group-hover:text-zinc-200">disponibilidad del sistema</div>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Hero animations
  gsap.from('.hero-eyebrow', { y: 20, opacity: 0, duration: 0.6, ease: 'power3.out', delay: 0.2 });
  gsap.from('.hero-word', { y: 60, opacity: 0, stagger: 0.06, duration: 0.8, ease: 'power4.out', delay: 0.35 });

  // Data flow SVG
  const dfLineEls = document.querySelectorAll('#df-lines line');
  const dfNodeCircles = document.querySelectorAll('#df-nodes circle');
  const dfNodeTexts = document.querySelectorAll('#df-nodes text');
  const dfCenter = document.getElementById('df-center');

  gsap.set(dfNodeTexts, { opacity: 0 });

  // Draw spokes outward from center
  dfLineEls.forEach((line, i) => {
    const x2 = Number((line as SVGLineElement).getAttribute('x2'));
    const y2 = Number((line as SVGLineElement).getAttribute('y2'));
    const len = Math.sqrt((x2 - 180) ** 2 + (y2 - 200) ** 2);
    (line as SVGLineElement).style.strokeDasharray = String(len);
    (line as SVGLineElement).style.strokeDashoffset = String(len);
    gsap.to(line, { strokeDashoffset: 0, duration: 0.9, delay: 0.4 + i * 0.08, ease: 'power2.out' });
  });

  // Source nodes appear
  gsap.from(dfNodeCircles, { opacity: 0, y: 6, stagger: 0.1, duration: 0.5, ease: 'power3.out', delay: 0.5 });
  gsap.to(dfNodeTexts, { opacity: 1, stagger: 0.1, duration: 0.4, delay: 1.2 });

  if (dfCenter) {
    gsap.to(dfCenter, { opacity: 1, duration: 0.6, delay: 1.5 });

    // Expanding pulse rings
    gsap.fromTo('#df-ring-1',
      { attr: { r: 32 }, opacity: 0.8 },
      { attr: { r: 85 }, opacity: 0, duration: 2.5, repeat: -1, ease: 'power2.out', delay: 2.0 }
    );
    gsap.fromTo('#df-ring-2',
      { attr: { r: 32 }, opacity: 0.5 },
      { attr: { r: 85 }, opacity: 0, duration: 2.5, repeat: -1, ease: 'power2.out', delay: 3.25 }
    );

    // Inward particles: source nodes → IA
    const srcCoords: [number, number][] = [
      [180, 55], [306, 128], [306, 273], [180, 345], [54, 273], [54, 128]
    ];
    const dfParticlesGroup = document.getElementById('df-particles');
    const srcNodes = Array.from(dfNodeCircles) as SVGCircleElement[];

    srcCoords.forEach(([sx, sy], i) => {
      const p = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      p.setAttribute('r', '3');
      p.setAttribute('fill', '#00D4FF');
      p.setAttribute('filter', 'url(#df-glow)');
      p.setAttribute('opacity', '0');
      dfParticlesGroup?.appendChild(p);
      function shoot() {
        gsap.timeline({ onComplete: () => gsap.delayedCall(1.5 + Math.random() * 3.5, shoot) })
          .set(p, { attr: { cx: sx, cy: sy }, opacity: 0 })
          .to(p, { attr: { cx: 180, cy: 200 }, opacity: 0.85, duration: 1.3, ease: 'power1.in' })
          .to(p, { opacity: 0, duration: 0.2 }, '-=0.2');
      }
      gsap.delayedCall(2.2 + i * 0.35, shoot);
    });

    // Random source node flash
    setInterval(() => {
      const node = srcNodes[Math.floor(Math.random() * srcNodes.length)];
      gsap.timeline()
        .to(node, { attr: { fill: '#00D4FF', r: 11 }, duration: 0.25, ease: 'power2.out' })
        .to(node, { attr: { fill: '#27272a', r: 9 }, duration: 0.5, ease: 'power2.inOut' });
    }, 900);
  }

  // ScrollTrigger reveals
  gsap.utils.toArray('.reveal-up').forEach((el: any) => {
    gsap.from(el, {
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' },
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out'
    });
  });

  gsap.utils.toArray('.reveal-stagger').forEach((container: any) => {
    gsap.from(container.children, {
      scrollTrigger: { trigger: container, start: 'top 85%' },
      y: 40, opacity: 0, stagger: 0.1, duration: 0.7, ease: 'power3.out'
    });
  });

  // Count-up
  gsap.utils.toArray('.count-up').forEach((el: any) => {
    const target = parseInt(el.dataset.target);
    const obj = { val: 0 };
    gsap.to(obj, {
      scrollTrigger: { trigger: el, start: 'top 90%' },
      val: target, duration: 2, ease: 'power2.out',
      onUpdate: function() { el.textContent = Math.round(obj.val); }
    });
  });
</script>
