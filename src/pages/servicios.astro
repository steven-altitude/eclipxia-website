---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Enterprise AI Implementation",
  "provider": {
    "@type": "Organization",
    "name": "Eclipxia",
    "url": "https://www.eclipxia.com"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios de IA Empresarial",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cerebros Corporativos", "description": "Bases de conocimiento privadas con IA para empresas" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Claude para Empresas", "description": "Implementación de Claude Cowork para equipos empresariales" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Habla con tus Datos", "description": "Sistemas RAG para consultar datos empresariales en lenguaje natural" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Onboarding Inteligente", "description": "IA para incorporación de nuevos colaboradores" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Asesor Contractual IA", "description": "Revisión y análisis de contratos con inteligencia artificial" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Automatizaciones", "description": "Automatización de procesos empresariales con IA" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "OpenClaw", "description": "Despliegue e integración del agente de IA local open source OpenClaw para equipos empresariales" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Chatbots de IA", "description": "Chatbots empresariales personalizados con IA" } }
    ]
  }
};

const services = [
  {
    num: '01',
    category: 'Inteligencia de Conocimiento',
    title: 'Cerebros Corporativos',
    tagline: 'Su conocimiento institucional, finalmente disponible.',
    body1: 'Construimos sistemas de recuperación de información (RAG) que indexan toda la documentación de su empresa — manuales, políticas, contratos, emails, wikis — y los hacen consultables en lenguaje natural. No buscadores. Sistemas que entienden el contexto y entregan respuestas precisas con referencias.',
    body2: 'Su equipo deja de buscar en carpetas. La respuesta aparece en segundos, con la fuente exacta de donde proviene.',
    benefits: [
      'Respuestas con citas: cada respuesta incluye la fuente exacta del documento',
      'Indexación incremental: nuevos documentos aparecen disponibles en minutos',
      'Control de acceso: cada empleado ve solo lo que tiene permisos para ver',
    ],
  },
  {
    num: '02',
    category: 'Implementación Enterprise',
    title: 'Claude para Empresas',
    tagline: 'El asistente que conoce su empresa.',
    body1: 'Implementamos Claude de Anthropic dentro de su infraestructura con configuraciones específicas para su industria, sus procesos y su cultura corporativa. No es el mismo Claude que cualquiera puede usar en el navegador — es uno entrenado con el contexto de su empresa.',
    body2: 'Políticas de uso definidas por usted. Datos que no salen de su infraestructura. Capacidad de auditar cada interacción.',
    benefits: [
      'Despliegue en su VPC o infraestructura cloud propia',
      'Políticas de uso y restricciones configuradas por su equipo',
      'Logs completos de uso para auditoría y cumplimiento',
    ],
  },
  {
    num: '03',
    category: 'Inteligencia de Conocimiento',
    title: 'Habla con tus Datos',
    tagline: 'Preguntas en lenguaje natural. Respuestas en datos reales.',
    body1: 'Conectamos sus bases de datos, ERP, CRM y dashboards a una interfaz conversacional. "¿Cuánto vendimos en Bogotá el Q3 comparado con el año anterior?" — respuesta en segundos, sin esperar al analista.',
    body2: 'El sistema genera SQL, lo ejecuta contra sus datos reales, y entrega la respuesta en lenguaje humano con gráficos cuando aplica.',
    benefits: [
      'Compatible con PostgreSQL, MySQL, BigQuery, Snowflake, SAP y más',
      'Validación de SQL antes de ejecutar — no corre consultas destructivas',
      'Exportación de resultados a Excel, PDF o Slack directo',
    ],
  },
  {
    num: '04',
    category: 'IA para Personas',
    title: 'Onboarding Inteligente',
    tagline: 'Nuevos colaboradores productivos desde la primera semana.',
    body1: 'Un asistente de IA que acompaña al nuevo empleado desde el día uno: explica procesos, responde preguntas frecuentes, conecta con las personas correctas y mide el progreso de adaptación.',
    body2: 'El equipo de RRHH deja de repetir las mismas respuestas. Los nuevos colaboradores aprenden más rápido. La rotación por desorientación inicial baja.',
    benefits: [
      'Rutas de aprendizaje personalizadas por rol y departamento',
      'Integración con Slack, Teams o su intranet actual',
      'Dashboard para RRHH con métricas de progreso y puntos de fricción',
    ],
  },
  {
    num: '05',
    category: 'Inteligencia de Conocimiento',
    title: 'Asesor Contractual IA',
    tagline: 'Revisión de contratos en minutos.',
    body1: 'Sistema de análisis de contratos que identifica cláusulas de riesgo, compara con sus estándares contractuales y genera un resumen ejecutivo antes de que el equipo legal dedique horas de revisión.',
    body2: 'No reemplaza al abogado. Le ahorra las horas que el abogado dedica a leer contratos de bajo riesgo para que pueda enfocarse en lo que realmente importa.',
    benefits: [
      'Comparación automática contra su biblioteca de contratos estándar',
      'Identificación de cláusulas inusuales con referencias de riesgo',
      'Resumen ejecutivo en español listo para decisores no legales',
    ],
  },
  {
    num: '06',
    category: 'IA para Procesos',
    title: 'Automatizaciones',
    tagline: 'Menos trabajo manual. Más trabajo real.',
    body1: 'Identificamos los flujos de trabajo que consumen más tiempo de su equipo — extracción de datos de PDFs, clasificación de emails, generación de reportes, aprobaciones — y los automatizamos con IA conectada a sus sistemas actuales.',
    body2: 'No remplazamos personas. Eliminamos el trabajo repetitivo para que las personas hagan el trabajo que requiere criterio.',
    benefits: [
      'Auditoría previa de procesos para priorizar el mayor impacto',
      'Integración nativa con sus herramientas: SAP, Salesforce, Gmail, Notion',
      'Monitoreo y alertas para cuando la automatización necesita intervención humana',
    ],
  },
  {
    num: '07',
    category: 'Implementación Enterprise',
    title: 'OpenClaw',
    tagline: 'El agente de IA local para su equipo.',
    body1: 'OpenClaw es un agente de IA open source que corre directamente en la máquina del usuario — sin servidores externos, sin suscripciones, sin que sus datos salgan del dispositivo. Controla el navegador, gestiona archivos, envía correos y ejecuta tareas de forma autónoma a través de WhatsApp, Telegram o Slack.',
    body2: 'Nosotros lo desplegamos, configuramos e integramos con los flujos de trabajo de su empresa. Sus equipos obtienen un asistente personal de IA completamente privado, sin depender de ninguna plataforma en la nube.',
    benefits: [
      'Privacidad total: todo corre en la máquina del usuario, sin APIs externas obligatorias',
      'Automatización real: inbox, calendario, documentos, navegador — controlados por IA',
      'Extensible: su equipo puede crear sus propias capacidades sin escribir código',
    ],
  },
  {
    num: '08',
    category: 'IA para Personas',
    title: 'Chatbots de IA',
    tagline: 'Conversaciones que convierten. No que frustran.',
    body1: 'Construimos chatbots que entienden el contexto de su empresa, saben cuándo escalar a un humano y mantienen la conversación en el tono de su marca. No son bots de árbol de decisión — son sistemas conversacionales entrenados con su contenido real.',
    body2: 'Para soporte al cliente, ventas, RRHH interno o cualquier punto de contacto donde la velocidad de respuesta importa y los volúmenes hacen imposible la atención 100% humana.',
    benefits: [
      'Escalada inteligente a humano con contexto completo de la conversación',
      'Multicanal: web, WhatsApp Business, Telegram, Slack',
      'Analytics de conversaciones para identificar patrones y mejorar continuamente',
    ],
  },
];

const industries = [
  {
    id: 'logistica',
    label: 'Log\u00edstica',
    title: 'C\u00f3mo se vería para empresas de log\u00edstica',
    body1: 'Una operaci\u00f3n con m\u00falfiples almacenes y proveedores tiene informaci\u00f3n cr\u00edtica repartida en sistemas separados: ERPs, hojas de Excel, emails y WhatsApps. El equipo de atenci\u00f3n dedica horas buscando el estado de un env\u00edo en lugar de responder al cliente.',
    body2: 'Con un sistema RAG conectado a todos esos sistemas, cualquier persona del equipo puede preguntar en lenguaje natural y obtener el estado actualizado en segundos — sin entrar a 4 sistemas distintos.',
    metric: 'Posible',
    metricLabel: 'respuesta inmediata en lugar de b\u00fasqueda manual entre sistemas',
    services: ['Habla con tus Datos', 'Chatbots de IA', 'Automatizaciones'],
  },
  {
    id: 'finanzas',
    label: 'Finanzas',
    title: 'C\u00f3mo se ver\u00eda para equipos financieros',
    body1: 'Los equipos de auditor\u00eda y finanzas dedican tiempo considerable a buscar en bases de datos hist\u00f3ricas, clasificar transacciones y generar reportes que en su mayor\u00eda son trabajo repetitivo y estructurado.',
    body2: 'Un sistema de IA conectado a los datos financieros puede automatizar la clasificaci\u00f3n, detectar anomal\u00edas autom\u00e1ticamente y generar reportes pre-estructurados — liberando a los analistas para el trabajo que requiere criterio real.',
    metric: 'Alto ROI',
    metricLabel: 'en tareas de clasificaci\u00f3n, b\u00fasqueda y generaci\u00f3n de reportes',
    services: ['Habla con tus Datos', 'Cerebros Corporativos', 'Automatizaciones'],
  },
  {
    id: 'legal',
    label: 'Legal',
    title: 'C\u00f3mo se ver\u00eda para departamentos legales',
    body1: 'Los equipos legales con contratos activos dedican tiempo valioso a la revisi\u00f3n inicial de documentos entrantes — buscando cl\u00e1usulas problem\u00e1ticas, comparando t\u00e9rminos contra est\u00e1ndares internos, identificando riesgos.',
    body2: 'Un Asesor Contractual IA analiza cada contrato en minutos, compara contra su biblioteca de est\u00e1ndares y genera un mapa de riesgo por cl\u00e1usula. El abogado revisa lo importante, no todo.',
    metric: 'Minutos',
    metricLabel: 'en lugar de horas para la revisi\u00f3n inicial de contratos',
    services: ['Asesor Contractual IA', 'Cerebros Corporativos'],
  },
  {
    id: 'rrhh',
    label: 'RRHH',
    title: 'C\u00f3mo se ver\u00eda para recursos humanos',
    body1: 'El onboarding de nuevos colaboradores consume tiempo significativo de RRHH respondiendo las mismas preguntas: pol\u00edticas, beneficios, procesos, herramientas. Y los nuevos ingresos nunca saben a qui\u00e9n preguntar qu\u00e9.',
    body2: 'Un asistente de IA entrenado con toda la informaci\u00f3n de la empresa responde 24/7 con precisi\u00f3n. RRHH deja de ser el helpdesk operativo y puede enfocarse en lo estrat\u00e9gico.',
    metric: '24/7',
    metricLabel: 'disponibilidad del asistente de incorporaci\u00f3n para nuevos colaboradores',
    services: ['Onboarding Inteligente', 'Cerebros Corporativos'],
  },
  {
    id: 'operaciones',
    label: 'Operaciones',
    title: 'C\u00f3mo se ver\u00eda para equipos de operaciones',
    body1: 'Los gerentes de operaci\u00f3n necesitan informaci\u00f3n actualizada para tomar decisiones: inventario, rutas, rendimiento por zona, estado de proveedores. Esa informaci\u00f3n existe, pero est\u00e1 en sistemas que nadie consulta r\u00e1pido.',
    body2: 'Con IA conectada a sus datos operacionales en tiempo real, cualquier gerente puede preguntar "¿cu\u00e1l es mi situaci\u00f3n hoy?" y obtener una respuesta contextualizada en segundos, sin reportes manuales.',
    metric: 'Tiempo real',
    metricLabel: 'visibilidad operacional sin reportes manuales',
    services: ['Habla con tus Datos', 'Automatizaciones'],
  },
];
---

<BaseLayout
  title="Servicios de IA Empresarial | Eclipxia — RAG, Automatizaciones, Chatbots"
  description="Servicios de IA para empresas: Cerebros Corporativos, RAG, Onboarding Inteligente, Asesor Contractual IA, Automatizaciones, OpenClaw y Chatbots. Implementación en producción."
  activePage="servicios"
  jsonLd={jsonLd}
>
  <!-- HERO -->
  <section class="min-h-[50dvh] flex flex-col justify-center pt-16 bg-zinc-950 relative overflow-hidden">
    <div class="absolute bottom-0 left-0 right-0 h-px bg-zinc-800"></div>
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 w-full pt-16 pb-8">
      <div class="hero-eyebrow flex items-center gap-2 mb-8 text-sm text-zinc-600">
        <a href="/" class="hover:text-zinc-400 transition-colors">Inicio</a>
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        <span class="text-zinc-400">Servicios</span>
      </div>
      <h1 class="text-4xl lg:text-5xl xl:text-6xl font-black tracking-tight leading-[1.05] max-w-[800px]">
        <span class="hero-word">Ocho</span>
        <span class="hero-word"> soluciones.</span>
        <br />
        <span class="hero-word">Una</span>
        <span class="hero-word"> sola</span>
        <span class="hero-word"> pregunta:</span>
        <br />
        <span class="hero-word text-cyan-400">&iquest;funciona</span>
        <span class="hero-word"> en</span>
        <span class="hero-word"> producci&oacute;n?</span>
      </h1>
      <p class="hero-sub text-lg text-zinc-400 mt-6 max-w-xl">Cada soluci&oacute;n est&aacute; dise&ntilde;ada para conectarse con sus sistemas reales — no para vivir en un sandbox.</p>
    </div>
  </section>

  <!-- CATEGORY CARDS -->
  <section class="bg-zinc-950 pt-8 pb-16">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 reveal-stagger">
        <div class="category-card bg-zinc-900 border border-zinc-800 rounded-2xl p-8 active hover:border-cyan-400/50 hover:[box-shadow:0_0_32px_-8px_#00d4ff40] transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-zinc-800 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          </div>
          <h3 class="text-xl font-bold text-zinc-50 mb-3">Inteligencia de Conocimiento</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-5">Sistemas que encuentran, estructuran y hacen disponible el conocimiento que ya existe en su empresa — contratos, manuales, pol&iacute;ticas, historial.</p>
          <div class="flex flex-wrap gap-2">
            <span class="text-xs bg-zinc-800 text-zinc-400 px-3 py-1 rounded-full">Cerebros Corporativos</span>
            <span class="text-xs bg-zinc-800 text-zinc-400 px-3 py-1 rounded-full">Habla con tus Datos</span>
            <span class="text-xs bg-zinc-800 text-zinc-400 px-3 py-1 rounded-full">Asesor Contractual</span>
          </div>
        </div>
        <div class="category-card bg-zinc-900 border border-zinc-800 rounded-2xl p-8 hover:border-cyan-400/50 hover:[box-shadow:0_0_32px_-8px_#00d4ff40] transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-zinc-800 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
          </div>
          <h3 class="text-xl font-bold text-zinc-50 mb-3">IA para Personas y Procesos</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-5">Automatizaciones y asistentes que reducen trabajo manual, aceleran onboarding y mejoran la experiencia de colaboradores y clientes.</p>
          <div class="flex flex-wrap gap-2">
            <span class="text-xs bg-zinc-800 text-zinc-400 px-3 py-1 rounded-full">Onboarding Inteligente</span>
            <span class="text-xs bg-zinc-800 text-zinc-400 px-3 py-1 rounded-full">Chatbots de IA</span>
            <span class="text-xs bg-zinc-800 text-zinc-400 px-3 py-1 rounded-full">Automatizaciones</span>
          </div>
        </div>
        <div class="category-card bg-zinc-900 border border-zinc-800 rounded-2xl p-8 hover:border-cyan-400/50 hover:[box-shadow:0_0_32px_-8px_#00d4ff40] transition-all duration-300">
          <div class="w-12 h-12 rounded-xl bg-zinc-800 flex items-center justify-center mb-5">
            <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <h3 class="text-xl font-bold text-zinc-50 mb-3">Implementaci&oacute;n Enterprise</h3>
          <p class="text-zinc-400 text-sm leading-relaxed mb-5">Para organizaciones que necesitan arquitectura de IA a nivel corporativo con control total.</p>
          <div class="flex flex-wrap gap-2">
            <span class="text-xs bg-zinc-800 text-zinc-400 px-3 py-1 rounded-full">Claude Enterprise</span>
            <span class="text-xs bg-zinc-800 text-zinc-400 px-3 py-1 rounded-full">OpenClaw</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES DETAIL -->
  <section class="bg-zinc-950 py-4 pb-28">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      {services.map((service) => (
        <div class="service-section py-20 relative reveal-up">
          <div class="num-bg">{service.num}</div>
          <div class="grid lg:grid-cols-[1fr_1.5fr] gap-16 items-start relative z-10">
            <div>
              <div class="text-xs font-semibold tracking-[0.25em] text-cyan-400 uppercase mb-4">{service.category}</div>
              <h2 class="text-3xl lg:text-4xl font-black tracking-tight mb-3">{service.title}</h2>
              <p class="text-xl text-cyan-400 font-medium mb-6">{service.tagline}</p>
              <a
                href="/contacto/"
                class="inline-flex items-center gap-2 text-zinc-300 hover:text-zinc-50 border border-zinc-700 hover:border-zinc-500 px-5 py-3 rounded-xl transition-colors text-sm"
              >
                Solicitar propuesta
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
              </a>
            </div>
            <div>
              <p class="text-zinc-400 leading-relaxed mb-6">{service.body1}</p>
              <p class="text-zinc-400 leading-relaxed mb-8">{service.body2}</p>
              <div class="space-y-4">
                {service.benefits.map((benefit) => (
                  <div class="benefit-item">
                    <svg class="w-5 h-5 text-cyan-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    <span class="text-zinc-300">{benefit}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- USE CASES BY INDUSTRY -->
  <section class="bg-zinc-900 py-20 border-t border-zinc-800">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10">
      <h2 class="reveal-up text-2xl font-bold mb-10">Casos de uso por industria</h2>
      <div class="reveal-up">
        <!-- Tab buttons -->
        <div class="flex gap-0 border-b border-zinc-800 mb-10 overflow-x-auto">
          {industries.map((ind, i) => (
            <button
              class={`tab-btn text-sm font-medium px-6 py-3 border-b-2 whitespace-nowrap transition-colors ${i === 0 ? 'active text-cyan-400 border-cyan-400' : 'text-zinc-400 border-transparent hover:text-zinc-200'}`}
              data-tab={ind.id}
            >
              {ind.label}
            </button>
          ))}
        </div>

        <!-- Tab content -->
        {industries.map((ind, i) => (
          <div id={`tab-${ind.id}`} class={`use-case grid lg:grid-cols-2 gap-12 items-center ${i === 0 ? 'active' : ''}`}>
            <div>
              <h3 class="text-2xl font-bold mb-4">{ind.title}</h3>
              <p class="text-zinc-400 leading-relaxed mb-4">{ind.body1}</p>
              <p class="text-zinc-400 leading-relaxed mb-6">{ind.body2}</p>
              <div class="flex items-center gap-3">
                <span class="text-3xl font-black text-cyan-400">{ind.metric}</span>
                <span class="text-zinc-500 text-sm">{ind.metricLabel}</span>
              </div>
            </div>
            <div class="bg-zinc-950 rounded-xl p-6 border border-zinc-800">
              <div class="text-xs font-mono text-zinc-600 mb-3">Servicios aplicados</div>
              <div class="space-y-2">
                {ind.services.map((s) => (
                  <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-cyan-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
                    <span class="text-sm text-zinc-300">{s}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-zinc-950 py-20 border-t border-zinc-800">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 text-center">
      <h2 class="reveal-up text-3xl lg:text-4xl font-black tracking-tight mb-4">
        &iquest;Su caso no est&aacute; aqu&iacute;?
      </h2>
      <p class="reveal-up text-zinc-400 max-w-xl mx-auto mb-8">
        Cada empresa tiene una combinaci&oacute;n &uacute;nica de sistemas, datos y procesos. Hablemos de su situaci&oacute;n espec&iacute;fica.
      </p>
      <a
        href="/contacto/"
        class="reveal-up cta-btn inline-flex items-center gap-2 bg-cyan-400 text-zinc-950 font-bold px-8 py-4 rounded-xl hover:bg-cyan-300 transition-colors"
      >
        Agendar diagn&oacute;stico gratuito
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Hero animations
  gsap.from('.hero-eyebrow', { y: 20, opacity: 0, duration: 0.6, ease: 'power3.out', delay: 0.2 });
  gsap.from('.hero-word', { y: 60, opacity: 0, stagger: 0.05, duration: 0.8, ease: 'power4.out', delay: 0.35 });
  gsap.from('.hero-sub', { y: 30, opacity: 0, duration: 0.7, ease: 'power3.out', delay: 1.0 });

  // ScrollTrigger reveals
  gsap.utils.toArray('.reveal-up').forEach((el: any) => {
    gsap.from(el, {
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none none' },
      y: 40, opacity: 0, duration: 0.8, ease: 'power3.out'
    });
  });

  gsap.utils.toArray('.reveal-stagger').forEach((container: any) => {
    gsap.from(container.children, {
      scrollTrigger: { trigger: container, start: 'top 85%' },
      y: 40, opacity: 0, stagger: 0.1, duration: 0.7, ease: 'power3.out'
    });
  });

  // Industry tabs
  const tabBtns = document.querySelectorAll('.tab-btn');
  const useCases = document.querySelectorAll('.use-case');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const tab = (btn as HTMLElement).dataset.tab;

      tabBtns.forEach((b) => {
        b.classList.remove('active', 'text-cyan-400', 'border-cyan-400');
        b.classList.add('text-zinc-400', 'border-transparent');
      });
      btn.classList.add('active', 'text-cyan-400', 'border-cyan-400');
      btn.classList.remove('text-zinc-400', 'border-transparent');

      useCases.forEach((uc) => {
        uc.classList.remove('active');
        if (uc.id === `tab-${tab}`) uc.classList.add('active');
      });
    });
  });
</script>
