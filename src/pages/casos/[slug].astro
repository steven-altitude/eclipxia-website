---
import { getCollection, render } from 'astro:content';
import BaseLayout, { WHATSAPP_URL } from '../../layouts/BaseLayout.astro';
import BlogShell from '../../components/BlogShell.astro';

export async function getStaticPaths() {
  const casos = (await getCollection('casos', ({ data }) => !data.draft)).sort(
    (a, b) => a.data.order - b.data.order,
  );
  return casos.map((caso, i) => ({
    params: { slug: caso.id },
    props: { caso, next: casos[(i + 1) % casos.length] },
  }));
}

const { caso, next } = Astro.props;
const { Content } = await render(caso);
const d = caso.data;

const url = `https://www.eclipxia.com/casos/${caso.id}/`;
const image = d.image ? new URL(d.image, 'https://www.eclipxia.com').href : undefined;

const caseLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.title,
  description: d.summary,
  inLanguage: 'es-EC',
  mainEntityOfPage: url,
  url,
  ...(image ? { image } : {}),
  about: { '@type': 'Organization', name: d.client },
  author: { '@type': 'Organization', name: 'Eclipxia', url: 'https://www.eclipxia.com/' },
  publisher: { '@id': 'https://www.eclipxia.com/#organization' },
  articleSection: 'Casos de éxito',
  keywords: d.services.join(', '),
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://www.eclipxia.com/' },
    { '@type': 'ListItem', position: 2, name: 'Casos de éxito', item: 'https://www.eclipxia.com/casos/' },
    { '@type': 'ListItem', position: 3, name: d.client, item: url },
  ],
};
---

<BaseLayout
  title={`${d.seoTitle ?? `${d.client}: caso de éxito`} | Eclipxia`}
  description={d.summary}
  canonical={url}
  ogImage={image}
  ogType="article"
  jsonLd={[caseLd, breadcrumbLd]}
>
  <BlogShell>
    <article class="post case">
      <header class="post-head">
        <nav class="post-crumbs" aria-label="Ruta">
          <a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/casos/">Casos de éxito</a>
        </nav>
        <p class="eyebrow">{d.client} · {d.sector}</p>
        <h1 class="post-h1">{d.title}</h1>
        <p class="post-lede">{d.summary}</p>
        {d.services.length > 0 && (
          <ul class="case-tags">
            {d.services.map((s) => <li>{s}</li>)}
          </ul>
        )}
      </header>

      {d.metrics.length > 0 && (
        <dl class="case-metrics">
          {d.metrics.map((m) => (
            <div class="case-metric">
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))}
        </dl>
      )}

      <div class="prose case-prose">
        <Content />
      </div>

      <section class="case-ai" aria-labelledby="case-ai-h">
        <p class="eyebrow">La IA como diferenciador</p>
        <h2 id="case-ai-h" class="case-ai-h">Dónde está la IA en este proyecto.</h2>
        <div class="case-ai-grid">
          <div class="case-ai-item">
            <span class="proc-chip">01</span>
            <h3>En cómo lo construimos</h3>
            <p>{d.aiBuild}</p>
          </div>
          <div class="case-ai-item">
            <span class="proc-chip">02</span>
            <h3>En cómo lo usa {d.client}</h3>
            <p>{d.aiUse}</p>
          </div>
        </div>
      </section>

      {d.note && <p class="case-note">{d.note}</p>}

      <aside class="post-cta">
        <p class="post-cta-q">¿Tu empresa tiene un problema parecido?</p>
        <p class="post-cta-p">Cuéntanos qué proceso quieres mejorar y te decimos, en una conversación, si la IA lo resuelve y por dónde empezar.</p>
        <a href={WHATSAPP_URL} class="btn-pill btn-pill-lg" target="_blank" rel="noopener noreferrer">Escribir por WhatsApp</a>
      </aside>

      {next && next.id !== caso.id && (
        <a class="case-next" href={`/casos/${next.id}/`}>
          <span class="eyebrow">Siguiente caso</span>
          <span class="case-next-title">{next.data.client}: {next.data.title}</span>
        </a>
      )}
    </article>
  </BlogShell>
</BaseLayout>
