---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Página no encontrada | Eclipxia"
  description="Esta página no existe. Vuelve al inicio de Eclipxia."
  robots="noindex, nofollow"
>
  <section class="min-h-[100dvh] flex items-center justify-center bg-zinc-950 relative overflow-hidden">
    <div class="absolute inset-0 grid-bg opacity-20 pointer-events-none"></div>
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 text-center relative z-10">
      <div class="text-[120px] lg:text-[180px] font-black text-zinc-900 leading-none select-none mb-4">404</div>
      <h1 class="text-3xl lg:text-4xl font-black text-zinc-50 mb-4">Esta p&aacute;gina no existe.</h1>
      <p class="text-zinc-400 max-w-sm mx-auto mb-10 leading-relaxed">
        El enlace que sigui&oacute; ya no funciona o nunca existi&oacute;. Nada que ver con la IA.
      </p>
      <a
        href="/"
        class="cta-btn inline-flex items-center gap-2 bg-cyan-400 text-zinc-950 font-semibold px-7 py-4 rounded-xl hover:bg-cyan-300 transition-colors"
      >
        Volver al inicio
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
