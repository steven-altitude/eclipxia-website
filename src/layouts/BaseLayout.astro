---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** JSON-LD adicional de la pagina (ej. BlogPosting en el blog) */
  jsonLd?: object | object[];
}

const {
  title = 'Inteligencia Artificial para Empresas en Ecuador | Eclipxia',
  description = 'Consultora de inteligencia artificial para empresas en Ecuador. Implementamos soluciones de IA que reducen costos y resuelven problemas reales en semanas.',
  canonical = 'https://www.eclipxia.com/',
  ogImage = 'https://www.eclipxia.com/eclipxia-logo.png',
  ogType = 'website',
  jsonLd: pageJsonLd,
} = Astro.props;
const extraLd = pageJsonLd ? (Array.isArray(pageJsonLd) ? pageJsonLd : [pageJsonLd]) : [];

// Punto de contacto principal: WhatsApp.
export const PHONE_E164 = '+593985479274';
export const PHONE_DISPLAY = '+593 98 547 9274';
export const WHATSAPP_URL =
  'https://wa.me/593985479274?text=Hola%20Eclipxia%2C%20quiero%20informaci%C3%B3n%20sobre%20sus%20servicios%20de%20IA.';

const keywords = [
  'inteligencia artificial Ecuador',
  'consultoría de inteligencia artificial Ecuador',
  'IA para empresas Ecuador',
  'consultora de IA Guayaquil',
  'automatización con inteligencia artificial',
  'capacitación en IA empresas',
  'agencia de inteligencia artificial Ecuador',
  'Eclipxia',
].join(', ');

const serviceCatalog: [string, string][] = [
  ['Consultoría y diagnóstico de inteligencia artificial', 'Auditoría de procesos, casos de uso priorizados y hoja de ruta de IA aterrizada a tu negocio.'],
  ['Capacitación de equipos en IA', 'Talleres prácticos y guías para que tu equipo use inteligencia artificial en su trabajo real.'],
  ['Cerebros corporativos (asistentes con IA)', 'Asistente interno conectado a tus documentos, contratos, políticas y sistemas.'],
  ['Automatización de flujos con IA', 'Eliminamos el trabajo manual repetitivo e integramos tus herramientas.'],
  ['Plataformas a medida con IA', 'Portales de clientes y paneles internos con inteligencia artificial integrada.'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': 'https://www.eclipxia.com/#organization',
  name: 'Eclipxia',
  alternateName: 'Eclipxia — Consultoría de Inteligencia Artificial',
  description,
  url: 'https://www.eclipxia.com/',
  image: ogImage,
  logo: ogImage,
  email: 'hola@eclipxia.com',
  telephone: PHONE_E164,
  sameAs: [WHATSAPP_URL],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer service',
    telephone: PHONE_E164,
    email: 'hola@eclipxia.com',
    areaServed: 'EC',
    availableLanguage: ['es'],
  },
  slogan: 'Inteligencia artificial que mueve a tu empresa.',
  priceRange: '$$',
  inLanguage: 'es-EC',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Edificio Xima, Piso 2, Oficina 218',
    addressLocality: 'Samborondón',
    addressRegion: 'Guayas',
    addressCountry: 'EC',
  },
  geo: { '@type': 'GeoCoordinates', latitude: -2.1333, longitude: -79.8833 },
  areaServed: [
    { '@type': 'Country', name: 'Ecuador' },
    { '@type': 'City', name: 'Guayaquil' },
    { '@type': 'City', name: 'Samborondón' },
    { '@type': 'City', name: 'Quito' },
  ],
  knowsAbout: [
    'Inteligencia artificial',
    'Consultoría de IA',
    'Automatización de procesos con IA',
    'Capacitación en inteligencia artificial',
    'Desarrollo de software con IA',
    'Asistentes corporativos (RAG)',
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de inteligencia artificial en Ecuador',
    itemListElement: serviceCatalog.map(([name, desc]) => ({
      '@type': 'Offer',
      itemOffered: {
        '@type': 'Service',
        name,
        description: desc,
        areaServed: 'Ecuador',
        provider: { '@id': 'https://www.eclipxia.com/#organization' },
      },
    })),
  },
};
---

<!DOCTYPE html>
<html lang="es-EC">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Eclipxia" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Local / geo signals -->
    <meta name="geo.region" content="EC-G" />
    <meta name="geo.placename" content="Samborondón, Guayas, Ecuador" />
    <meta name="geo.position" content="-2.1333;-79.8833" />
    <meta name="ICBM" content="-2.1333, -79.8833" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content="Eclipxia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Eclipxia — Inteligencia artificial para empresas en Ecuador" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: Geist + Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}

    <!-- Enable progressive-enhancement reveal only when JS is available -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />

    <!-- Botón flotante de WhatsApp — punto de contacto principal -->
    <a
      class="wa-fab"
      href={WHATSAPP_URL}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Escríbenos por WhatsApp al ${PHONE_DISPLAY}`}
    >
      <svg class="wa-fab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
      </svg>
      <span class="wa-fab-label">WhatsApp</span>
    </a>

    <Analytics />
    <SpeedInsights />
  </body>
</html>
