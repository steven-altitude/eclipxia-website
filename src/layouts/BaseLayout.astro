---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';

export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
}

const {
  title = 'Eclipxia — Consultoría e ingeniería de IA',
  description = 'No somos una agencia de desarrollo. Diagnosticamos, diseñamos e implementamos soluciones de IA que reducen costos y resuelven, en semanas, los problemas que frenan a las grandes organizaciones.',
  canonical = 'https://www.eclipxia.com/',
  ogImage = 'https://www.eclipxia.com/eclipxia-logo.png',
} = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Eclipxia',
  description,
  url: 'https://www.eclipxia.com/',
  email: 'hola@eclipxia.com',
  areaServed: 'EC',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Edificio Xima, Piso 2, Oficina 218',
    addressLocality: 'Samborondón',
    addressCountry: 'EC',
  },
  knowsAbout: [
    'Consultoría de inteligencia artificial',
    'Automatización de procesos',
    'Capacitación en IA',
    'Desarrollo de plataformas a medida',
  ],
};
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Eclipxia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts: Geist + Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Enable progressive-enhancement reveal only when JS is available -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <slot />
    <Analytics />
    <SpeedInsights />
  </body>
</html>
