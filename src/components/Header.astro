---
interface Props {
  activePage?: string;
}
const { activePage = '' } = Astro.props;

const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/nosotros/' },
  { label: 'Servicios', href: '/servicios/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contacto', href: '/contacto/' },
];
---

<header id="main-nav" class="sticky top-0 z-50 bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 h-16 flex items-center justify-between">
    <a href="/" class="flex-shrink-0">
      <img src="/logos/logo-blanco.png" alt="Eclipxia" class="h-10 lg:h-11 w-auto" />
    </a>

    <!-- Desktop nav -->
    <nav class="hidden lg:flex items-center gap-8">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={`nav-link text-sm transition-colors ${
            activePage === link.label.toLowerCase()
              ? 'active text-zinc-300 hover:text-zinc-50'
              : 'text-zinc-400 hover:text-zinc-50'
          }`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="/contacto/"
        class="cta-btn bg-cyan-400 text-zinc-950 text-sm font-semibold px-5 py-2.5 rounded-lg hover:bg-cyan-300 transition-colors"
      >
        Agendar diagn&oacute;stico
      </a>
    </nav>

    <!-- Hamburger -->
    <button id="hamburger" class="lg:hidden flex flex-col gap-1.5 p-2" aria-label="Abrir men&uacute;">
      <span class="w-6 h-0.5 bg-zinc-400 transition-all duration-300" id="ham-1"></span>
      <span class="w-6 h-0.5 bg-zinc-400 transition-all duration-300" id="ham-2"></span>
      <span class="w-4 h-0.5 bg-zinc-400 transition-all duration-300" id="ham-3"></span>
    </button>
  </div>
</header>

<!-- Mobile menu -->
<div id="mobile-menu" class="mobile-menu fixed inset-0 z-40 bg-zinc-950 flex flex-col justify-center items-start px-10 pt-16">
  <nav class="flex flex-col gap-8">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class={`text-4xl font-bold transition-colors hover:text-cyan-400 ${
          activePage === link.label.toLowerCase() ? 'text-zinc-50' : 'text-zinc-400'
        }`}
      >
        {link.label}
      </a>
    ))}
  </nav>
  <a
    href="/contacto/"
    class="mt-12 bg-cyan-400 text-zinc-950 font-semibold px-8 py-4 rounded-xl text-lg"
  >
    Agendar diagn&oacute;stico
  </a>
</div>

<script>
  import gsap from 'gsap';

  // Nav entrance animation
  gsap.from('#main-nav', {
    y: -60,
    opacity: 0,
    duration: 0.8,
    ease: 'power3.out',
  });

  // Mobile menu toggle
  const hamburger = document.getElementById('hamburger');
  const mobileMenu = document.getElementById('mobile-menu');
  const ham1 = document.getElementById('ham-1');
  const ham2 = document.getElementById('ham-2');
  const ham3 = document.getElementById('ham-3');
  let menuOpen = false;

  hamburger?.addEventListener('click', () => {
    menuOpen = !menuOpen;
    mobileMenu?.classList.toggle('open', menuOpen);
    if (ham1) ham1.style.transform = menuOpen ? 'rotate(45deg) translate(4px, 4px)' : '';
    if (ham2) ham2.style.opacity = menuOpen ? '0' : '';
    if (ham3) {
      ham3.style.transform = menuOpen ? 'rotate(-45deg) translate(4px, -4px)' : '';
      ham3.style.width = menuOpen ? '24px' : '';
    }
  });
</script>
