---
const navLinks = [
  { label: 'Inicio', href: '/' },
  { label: 'Nosotros', href: '/nosotros/' },
  { label: 'Servicios', href: '/servicios/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contacto', href: '/contacto/' },
];
---

<footer class="bg-zinc-900 border-t border-zinc-800">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
      <!-- Col 1: Logo + tagline -->
      <div>
        <a href="/">
          <img src="/logos/logo-blanco.png" alt="Eclipxia" class="h-8 w-auto mb-4" />
        </a>
        <p class="text-zinc-400 text-sm leading-relaxed max-w-xs">
          IA empresarial que llega a producci&oacute;n.
        </p>
        <p class="text-zinc-500 text-xs mt-3 leading-relaxed max-w-xs">
          Consultora enterprise de implementaci&oacute;n de inteligencia artificial en Am&eacute;rica Latina.
        </p>
      </div>

      <!-- Col 2: Nav links -->
      <div>
        <h4 class="text-xs font-semibold tracking-widest text-zinc-500 uppercase mb-5">Navegaci&oacute;n</h4>
        <nav class="flex flex-col gap-3">
          {navLinks.map((link) => (
            <a href={link.href} class="text-sm text-zinc-400 hover:text-zinc-50 transition-colors">
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Col 3: Contact -->
      <div>
        <h4 class="text-xs font-semibold tracking-widest text-zinc-500 uppercase mb-5">Contacto</h4>
        <a
          href="mailto:contacto@eclipxia.com"
          class="text-sm text-zinc-400 hover:text-cyan-400 transition-colors block mb-2"
        >
          contacto@eclipxia.com
        </a>
        <p class="text-xs text-zinc-600 mb-5">Respuesta en &lt; 24 horas</p>
        <div class="flex gap-3">
          <a
            href="https://linkedin.com/company/eclipxia"
            target="_blank"
            rel="noopener noreferrer"
            class="w-9 h-9 rounded-lg bg-zinc-800 flex items-center justify-center hover:bg-zinc-700 transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4 text-zinc-400" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-zinc-800">
    <div class="max-w-[1400px] mx-auto px-6 lg:px-10 py-5 flex flex-col sm:flex-row justify-between items-center gap-3">
      <span class="text-xs text-zinc-600">&copy; 2026 Eclipxia. Todos los derechos reservados.</span>
      <span class="text-xs text-zinc-600">Hecho con Astro &middot; Desplegado en Vercel</span>
    </div>
  </div>
</footer>
